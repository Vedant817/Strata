# Strata environment
#
# Copy to `.env` (gitignored) and fill in. Astro loads this for SSR; nothing
# here is ever exposed to the browser, because none of these names carry the
# `PUBLIC_` prefix.

# Resend — the claim-email and digest transport.
# This must be an API key (starts with re_), created in the Resend dashboard
# under API Keys. The `resend` CLI's own login is an OAuth grant held in the OS
# credential store, which the app cannot read and should not use: shelling out
# to an authenticated CLI from a web request is not a mail transport.
# Without this, claim links are shown on screen instead of emailed, and the UI
# says so rather than pretending an inbox is waiting.
RESEND_API_KEY=

# Verified sender. Until a domain is verified, use Resend's test sender:
# MAIL_FROM=Strata <onboarding@resend.dev>
MAIL_FROM=Strata <onboarding@resend.dev>

# Absolute origin. Drives canonical URLs, the sitemap, and og:image.
# SITE_URL=https://strata.pub

# LibSQL. Defaults to a local file; point at Turso for a hosted deploy.
# DATABASE_URL=file:./data/strata.db
# DATABASE_AUTH_TOKEN=
