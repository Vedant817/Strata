# Strata environment
#
# Copy to `.env` (gitignored) and fill in. Astro loads this for SSR; nothing
# here is ever exposed to the browser, because none of these names carry the
# `PUBLIC_` prefix.

# Mail transport. Two providers behind one interface; whichever key is present
# wins, Brevo first. Without either, claim links are shown on screen instead of
# emailed, and the UI says so rather than pretending an inbox is waiting.
#
# Brevo — the one to use when you have no domain of your own. Free tier is
# 300 emails/day, no card and no DNS: Brevo -> Senders & IP -> add your own
# address (a plain Gmail is fine) -> click the verification link they email
# you. After that you can send to any recipient. Keys start with `xkeysib-`.
#   https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
#
# Resend — the original transport, and still what runs when there is no Brevo
# key. Keys start with `re_`, from API Keys in the Resend dashboard. The
# `resend` CLI's own login is an OAuth grant held in the OS credential store,
# which the app cannot read and should not use: shelling out to an
# authenticated CLI from a web request is not a mail transport. Resend will only
# send to arbitrary recipients once you own and verify a sending domain, so
# without one it stays on the onboarding sandbox.
RESEND_API_KEY=

# Pin a transport instead of letting the first key win.
# MAIL_PROVIDER=brevo
MAIL_PROVIDER=

# The From address, which must match the sender verified in whichever provider
# is active or the send is refused.
#   Brevo, single-sender verified — just your own address:
#     MAIL_FROM=Strata <you@gmail.com>
#   Resend with no domain of your own — the sandbox, which delivers to
#   @resend.dev recipients only:
MAIL_FROM=Strata <onboarding@resend.dev>
MAIL_FROM=Strata <onboarding@resend.dev>

# Absolute origin. Drives canonical URLs, the sitemap, and og:image.
# SITE_URL=https://strata.pub

# LibSQL. Defaults to a local file; point at Turso for a hosted deploy.
# The app migrates on boot, so a fresh remote only needs the URL and a token —
# then `npm run db:seed` fills it. On Windows the Turso CLI lives in WSL:
#   wsl -d Ubuntu -- bash -lc "turso db create strata"
#   wsl -d Ubuntu -- bash -lc "turso db tokens create strata --expiration never"
# DATABASE_URL=file:./data/strata.db
# DATABASE_AUTH_TOKEN=

# Shared secret for /api/cron/digest. Without it the digest endpoint 401s
# everything — including its own preview — so a misconfigured scheduler fails
# loudly instead of silently never sending. Any long random string.
# CRON_SECRET=

# Model-backed Ask (optional). Without a key, Ask stays fully extractive: the
# answer is always quotes from the post, which cannot hallucinate and costs
# nothing. With a key, the model summarizes those same retrieved quotes — it
# only ever sees the passages, so grounding is structural.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Ask cost boundary. The daily cap is enforced per author in the database, so
# a restart can't reset it and two instances can't each spend the budget.
# ASK_DAILY_CAP=25
# After this many consecutive upstream failures the breaker opens, so one bad
# afternoon stops costing money on every request instead of on the tenth.
# ASK_BREAKER_AFTER=3
# ASK_BREAKER_MS=60000
# ASK_TIMEOUT_MS=8000
