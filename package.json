{
  "name": "ssr-blog",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "node ./dist/server/entry.mjs",
    "astro": "astro",
    "check": "astro check",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "import:markdown": "tsx scripts/import-markdown.ts",
    "db:reset": "node -e \"for(const f of ['data/strata.db','data/strata.db-journal'])require('fs').rmSync(f,{force:true})\" && npm run db:seed",
    "lint:design": "node scripts/lint-design.mjs",
    "verify": "npm run lint:design && npm run check && npm run test:anchors",
    "dev:clean": "node -e \"require('fs').rmSync('node_modules/.vite',{recursive:true,force:true})\" && npm run dev",
    "perf:budget": "tsx scripts/perf-budget.ts",
    "test:smoke": "node scripts/smoke.mjs",
    "test:anchors": "tsx scripts/test-anchors.ts",
    "test:anchor-survival": "tsx scripts/prove-anchor-survival.ts",
    "test:annotations": "tsx scripts/check-annotation-invariants.ts && tsx scripts/check-publication-notes.ts && tsx scripts/check-migration-0020.ts",
    "test:sandbox": "tsx scripts/check-sandbox-invariants.ts",
    "test:sandbox:browser": "node scripts/check-sandbox-in-browser.mjs",
    "test:passkeys:browser": "node scripts/check-passkey-roundtrip.mjs",
    "test:migration": "tsx scripts/check-migration-0020.ts",
    "test:autopsy": "tsx scripts/check-autopsy.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.5.10",
    "@astrojs/node": "^11.1.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.11",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@libsql/client": "^0.18.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "astro": "^7.3.5",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.3",
    "nanoid": "^6.0.1",
    "react": "^19.3.0",
    "satori": "^0.33.5",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.4.3",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15"
  },
  "overrides": {
    "braces": "^3.0.3",
    "fflate": "^0.8.3"
  }
}
