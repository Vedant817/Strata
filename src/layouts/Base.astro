---
import { resolvePrefs, THEME_COOKIE, DENSITY_COOKIE, ensureAnonId, type ReaderPrefs } from '../lib/prefs';
import { safeJsonLd } from '../lib/jsonld';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogType?: string;
  noindex?: boolean;
  prefs?: ReaderPrefs;
  /** Extra JSON-LD graph nodes, serialised by the caller. */
  jsonLd?: unknown[];
  /** Absolute or root-relative URL of the share image. When set, the card
   *  actually exists — `summary_large_image` without an image is a blank card,
   *  which is what every post shared until this prop existed. */
  ogImage?: string;
  bodyClass?: string;
}

const {
  title,
  description = 'Strata — long-form that admits it is out of date. Read at your depth, argue in the margins.',
  canonical,
  ogType = 'website',
  noindex = false,
  jsonLd = [],
  ogImage,
  bodyClass = '',
} = Astro.props;

const anonId = ensureAnonId(Astro.cookies);

const prefs = Astro.props.prefs ?? resolvePrefs(Astro.cookies as never, anonId);
const site = Astro.site ?? new URL('http://localhost:4321');
const pageTitle = !title || title === 'Strata' ? 'Strata' : `${title} · Strata`;
const canonicalUrl = canonical ? new URL(canonical, site).href : Astro.url.href;
/* `safeJsonLd`, not `JSON.stringify`: a reader-controlled Ask question reaches
   this graph, and an unescaped `</script>` inside it would close the block and
   execute whatever followed. See src/lib/jsonld.ts. */
const graph = jsonLd.length
  ? safeJsonLd({ '@context': 'https://schema.org', '@graph': jsonLd })
  : null;

/* The face that paints the LCP element.

   Every article's largest contentful element is body text in IBM Plex Serif
   400, and measured on the Slow 4G profile the font request did not start until
   first layout (~819ms) — nothing references the file until the browser has
   parsed the CSS and decided what to paint. A preload starts the fetch when the
   head is parsed instead, which is ~70ms earlier, and 70ms is 5% of the 1500ms
   LCP budget this product is held to.

   Imported with `?url` so this resolves to the same hashed asset the stylesheet
   already references rather than adding a second copy of the font. */
import plexSerifRegularUrl from '@fontsource/ibm-plex-serif/files/ibm-plex-serif-latin-400-normal.woff2?url';
---

<!doctype html>
<html lang="en" data-theme={prefs.theme} data-density={prefs.density}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={plexSerifRegularUrl} as="font" type="font/woff2" crossorigin />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content={prefs.theme === 'ink' ? '#100f0d' : '#faf9f5'} />
    {/* Declared so a phone can offer Strata in its share sheet. The share
        target runs on GET specifically because a POST target would require a
        service worker to intercept the navigation — and this site ships zero
        workers, by design. */}
    <link rel="manifest" href="/manifest.webmanifest" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Strata" />
    <meta property="og:title" content={title ?? 'Strata'} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {
      ogImage ? (
        <>
          <meta property="og:image" content={new URL(ogImage, site).href} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={title ?? 'Strata'} />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:image" content={new URL(ogImage, site).href} />
        </>
      ) : (
        <meta name="twitter:card" content="summary" />
      )
    }
    <meta name="twitter:title" content={title ?? 'Strata'} />
    <meta name="twitter:description" content={description} />

    <link rel="alternate" type="application/rss+xml" title="Strata — all writing" href="/rss.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {graph && <script is:inline type="application/ld+json" set:html={graph} />}

    {/* Runs before first paint so a reader on a dark OS never sees a white flash. */}
    <script is:inline define:vars={{ themeCookie: THEME_COOKIE, densityCookie: DENSITY_COOKIE }}>
      (() => {
        const read = (name) =>
          (document.cookie.match(new RegExp('(?:^|; )' + name + '=([^;]*)')) || [])[1];
        const stored = read(themeCookie);
        if (stored === 'paper' || stored === 'ink') {
          document.documentElement.dataset.theme = stored;
        } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          document.documentElement.dataset.theme = 'ink';
        }
        const d = read(densityCookie);
        if (d) document.documentElement.dataset.density = d;
      })();
    </script>
    {/* First-party error capture. There is no third-party analytics on this
        site, which also means there is nowhere for a client-side exception to
        go. Keep the last few on window so a broken island can be diagnosed
        from the console instead of guessing. */}
    <script is:inline>
      (() => {
        window.__strataErrors = [];
        const keep = (kind, message, stack) => {
          window.__strataErrors.push({ kind, message: String(message), stack: String(stack || '').slice(0, 600) });
          if (window.__strataErrors.length > 20) window.__strataErrors.shift();
        };
        window.addEventListener('error', (e) => keep('error', e.message, e.error && e.error.stack));
        window.addEventListener('unhandledrejection', (e) => keep('rejection', e.reason));
      })();
    </script>
  </head>

  <body class={bodyClass}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-ink focus:px-3 focus:py-2 focus:text-paper"
    >
      Skip to content
    </a>

    <SiteHeader />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <SiteFooter />

    <slot name="scripts" />
  </body>
</html>
