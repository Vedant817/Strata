---
import Base from '../layouts/Base.astro';
---

<Base title="Strata">
  <div class="shell py-20">
    <h1 class="measure text-4xl">Strata</h1>
    <p class="measure mt-4 text-ink-2">Toolchain check — tokens, fonts, islands, adapter.</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <span class="meta border border-rule px-2 py-1">paper / ink</span>
      <span class="meta border border-rule px-2 py-1">mono label</span>
      <code class="border border-rule bg-sunken px-2 py-1 text-xs">inline code</code>
    </div>
    <p class="measure mt-8">
      Body copy renders in <strong>IBM Plex Serif</strong> with a hard measure, real italics
      (<em>like this</em>), and a <a href="#">link that uses the single accent</a>.
    </p>
  </div>
</Base>
