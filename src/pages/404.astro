---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" description="That page does not exist." noindex>
  <div class="shell py-24">
    <p class="meta">404</p>
    <h1 class="measure mt-3 text-3xl">This page isn't here.</h1>
    <p class="measure mt-4 text-ink-2">
      It may have been renamed, or it may never have existed. Both happen.
    </p>
    <ul class="measure mt-8 space-y-2">
      <li><a href="/writing">All writing</a></li>
      <li><a href="/topics">Browse by topic</a></li>
      <li><a href="/">Back to the front page</a></li>
    </ul>
  </div>
</Base>
