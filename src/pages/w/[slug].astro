---
import Base from '../../layouts/Base.astro';
import Prose from '../../components/Prose.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import DepthDial from '../../components/DepthDial.astro';
import Marginalia from '../../components/Marginalia.astro';
import {
  getAdjacent,
  getLastReceipt,
  getPostBySlug,
  getRevisionView,
  getVersions,
  incrementViews,
  recordRead,
} from '../../lib/repo/posts';
import { getIdentity } from '../../lib/repo/auth';
import { countParticipants, listAnnotations, myReactions, voterKeyFor } from '../../lib/repo/annotations';
import { listMentions } from '../../lib/repo/webmentions';
import { isSaved, memoryKeyFor } from '../../lib/repo/reader';
import { getMyHighlights, getPostHighlights } from '../../lib/repo/highlights';
import { myReadingLists } from '../../lib/repo/taxonomy';
import { askPost } from '../../lib/repo/ask';
import {
  citationIsShareable,
  citationOgPath,
  citationSharePath,
  citationShareText,
  cleanAskQuestion,
  isUnfurlCrawler,
} from '../../lib/citation-card';
import { stressTest } from '../../lib/repo/stress';
import { getNeighbourhood } from '../../lib/repo/taxonomy';
import Neighbourhood from '../../components/Neighbourhood.astro';
import NextReads from '../../components/NextReads.astro';
import { recommendAfterRead } from '../../lib/repo/recommend';
import { PROVIDERS } from '../../lib/ai/providers';
import { houseKeyFor, freeClaimCaveat } from '../../lib/ai/catalog';
import { resolveKey } from '../../lib/repo/providerKeys';
import { blockToPlainText } from '../../lib/blocks';
import { resolvePrefs, DEPTH_COOKIE, ensureAnonId, type Depth } from '../../lib/prefs';
import { minutesAtDepth } from '../../lib/blocks';
import { diffStats } from '../../lib/diff';
import { ago, longDate, shortAgo, plural, verb } from '../../lib/format';
import { stripInline } from '../../lib/inline';

const { slug } = Astro.params;
const post = slug ? await getPostBySlug(slug) : null;
if (!post) return new Response(null, { status: 404, statusText: 'Not found' });

// Reading state. The page renders at the depth the reader chose, server-side —
// the dial is an enhancement over a complete document, not the source of it.
// The id is minted here (not fallen back to a throwaway) because this page
// writes read receipts under it — see `ensureAnonId`.
const anonId = ensureAnonId(Astro.cookies);
const identity = await getIdentity(Astro.cookies);
const prefs = resolvePrefs(Astro.cookies as never, anonId);
const depth: Depth = prefs.depth;

/** Revision view. `?rev=N` renders any historical version in place. A revision
 *  that does not exist is a bad link, not a crash — answer 404 honestly so it
 *  shows up in logs instead of silently rendering the current version. */
const requestedRev = Number(Astro.url.searchParams.get('rev') ?? '');
const isViewingOld = Number.isFinite(requestedRev) && requestedRev > 0;
const view = await getRevisionView(post.id, isViewingOld ? requestedRev : undefined);
if (!view) return new Response(null, { status: 404, statusText: 'Not found' });

const doc = post.blocks;
const hasUnderstand = doc.some((b) => b.layer === 'understand');
const hasMaster = doc.some((b) => b.layer === 'master');
const minutes = {
  skim: minutesAtDepth(doc, 'skim'),
  understand: minutesAtDepth(doc, 'understand'),
  master: minutesAtDepth(doc, 'master'),
};

// Telemetry must never block or fail the response.
void (async () => {
  try {
    await recordRead({ postId: post.id, versionId: post.version.id, anonId, userId: identity.userId });
    await incrementViews(post.id);
  } catch (err) {
    console.error('[strata] read receipt failed', err);
  }
})();

const versions = await getVersions(post.id);
const lastSeen = await getLastReceipt(anonId, post.id);
const nextReads = lastSeen
  ? await recommendAfterRead(anonId, identity.userId, post.id)
  : [];
const hasChangesSince = Boolean(
  lastSeen && lastSeen.versionId !== view.current.id && lastSeen.versionNumber < view.current.versionNumber,
);

const stats = diffStats(view.diff);
const reviewed = post.lastReviewedAt ? shortAgo(post.lastReviewedAt) : null;
const { newer, older } = await getAdjacent(post.id);

// Marginalia, resolved against the text the reader is actually looking at.
const blockTexts = new Map(doc.map((b) => [b.id, blockToPlainText(b)]));
const mentions = await listMentions(post.id);
const allNotes = await listAnnotations(post.id, blockTexts, {
  anonId,
  authorId: identity.userId,
  currentVersionId: post.currentVersionId ?? '',
});

/** Sort modes. "Contested" is the one that matters: a post where readers
 *  disagree with each other is where the argument is actually happening, and
 *  ordering by age hides it under whoever typed first. */
const NOTE_SORTS = ['newest', 'top', 'contested', 'author'] as const;
type NoteSort = (typeof NOTE_SORTS)[number];
const sortParam = Astro.url.searchParams.get('notes');
const noteSort: NoteSort = (NOTE_SORTS as readonly string[]).includes(sortParam ?? '')
  ? (sortParam as NoteSort)
  : 'newest';

const reactionTotal = (n: (typeof allNotes)[number]) =>
  n.reactions.useful + n.reactions.insightful + n.reactions.source;

const sortNotes = (list: typeof allNotes) => {
  const copy = [...list];
  switch (noteSort) {
    case 'top':
      return copy.sort((a, b) => reactionTotal(b) - reactionTotal(a) || a.createdAt - b.createdAt);
    case 'contested':
      // Disagreement first, then the notes drawing the most response.
      return copy.sort((a, b) => {
        const rank = (n: (typeof allNotes)[number]) =>
          (n.kind === 'disagreement' || n.kind === 'correction' ? 1000 : 0) + n.replies;
        return rank(b) - rank(a) || a.createdAt - b.createdAt;
      });
    case 'author':
      return copy.sort((a, b) => Number(b.isAuthor) - Number(a.isAuthor) || a.createdAt - b.createdAt);
    default:
      return copy.sort((a, b) => b.createdAt - a.createdAt);
  }
};

const rootNotes = allNotes.filter((n) => !n.parentId);
const repliesByParent: Record<string, typeof allNotes> = {};
for (const note of allNotes) {
  if (!note.parentId) continue;
  (repliesByParent[note.parentId] ??= []).push(note);
}
for (const list of Object.values(repliesByParent)) {
  list.sort((a, b) => a.createdAt - b.createdAt);
}

const notesByBlock: Record<string, typeof rootNotes> = {};
for (const note of sortNotes(rootNotes)) {
  (notesByBlock[note.blockId] ??= []).push(note);
}

const participants = await countParticipants(post.id);
const myNoteCount = allNotes.filter((n) => n.isMine).length;
const isPostAuthor = identity.userId === post.authorId;
const staleNotes = allNotes.filter((n) => n.onOlderRevision).length;

/** Which reactions this reader has already given, so the buttons can be pressed
 *  rather than merely counted. */
const myReactionSet = await myReactions(
  voterKeyFor(identity.userId, anonId),
  allNotes.map((n) => n.id),
);
const mineReactions = [...myReactionSet];
const isSavedNow = await isSaved(memoryKeyFor(identity.userId, anonId), post.id);
const ownLists = identity.userId ? await myReadingLists(identity.userId) : [];

/** This reader's own highlights on this post, if any — the only place a
 *  highlight is ever shown to the person who made it. */
const myHighlights = (await getMyHighlights(anonId, identity.userId)).filter(
  (h) => h.postSlug === post.slug,
);
const myHighlightCount = myHighlights.length;

/** The same highlights, keyed by block, so the prose can paint the quotes back
 *  onto the words. Previously the mark only existed for the lifetime of the
 *  click that made it — reload the article and a reader's own highlighting was
 *  gone from the text, only the list at the foot remembered it. */
const myBlockHighlights: Record<string, string[]> = {};
for (const h of await getPostHighlights(post.id, anonId, identity.userId)) {
  (myBlockHighlights[h.blockId] ??= []).push(h.text);
}

/** Where a form post should return to: this page, query string intact, so the
 *  reader lands back on the revision or sort they were reading. */
const returnTo = Astro.url.pathname + Astro.url.search;
const noteError = Astro.url.searchParams.get('noteError');
const subscribeState = Astro.url.searchParams.get('subscribe');
const errorNoteId = Astro.url.searchParams.get('note');

/** Ask this article. A GET, so an answer is a link anyone can open — and so a
 *  asked-and-answered question is as shareable as the post itself. */
const askQuery = (Astro.url.searchParams.get('ask') ?? '').trim().slice(0, 500);
/* A link-preview fetcher opening the shared URL is not a reader asking a
   question. Left as-is it would spend a quota slot, call a model, and file a
   row in the writer's confusion list — the shared link would manufacture the
   very signal the writer reads as "readers are stuck here". The card still
   renders for the crawler (that is the unfurl), it just never bills or logs. */
const askFromCrawler = isUnfurlCrawler(Astro.request.headers.get('user-agent'));
const askAsked = askQuery.length >= 3 && !askFromCrawler;
/** Stress-test: opt-in via its own param, never on by default. It spends the
 *  reader's quota across several model calls, so it must be something they
 *  asked for, not something that runs because the page loaded. */
const stressAsked = Astro.url.searchParams.get('stress') === '1';
const askProviderParam = Astro.url.searchParams.get('askProvider') ?? '';
const askModelParam = Astro.url.searchParams.get('askModel') ?? '';
const askProvider = PROVIDERS.some((p) => p.id === askProviderParam) ? askProviderParam : '';
const askModel = askModelParam.slice(0, 120);
const askResult = askAsked
  ? await askPost(
      post.id,
      view.current.id,
      askQuery,
      identity.userId,
      3,
      {
        providerId: askProvider || null,
        model: askModel || null,
      },
      anonId,
    )
  : null;

/** The adversarial pass over the same passages Ask works from. */
const stressResult = stressAsked
  ? await stressTest(
      post.id,
      view.current.id,
      identity.userId,
      {
        maxClaims: 4,
        pref: { providerId: askProvider || null, model: askModel || null },
        anonId,
      },
    )
  : null;

/** Where this post sits in the graph, or null if it is not in the public graph. */
const neighbourhood = await getNeighbourhood(post.id).catch(() => null);

/** Providers this reader could actually use: their own keys, plus the owner's. */
const readerHasKey = new Set<string>();
if (identity.userId) {
  for (const p of PROVIDERS) {
    if (await resolveKey(identity.userId, p.id).catch(() => null)) readerHasKey.add(p.id);
  }
}
const askProviders = PROVIDERS.filter((p) => readerHasKey.has(p.id) || Boolean(houseKeyFor(p.id)));
/**
 * Per-provider honesty about the word "free". OpenRouter publishes prices, so
 * offering only zero-cost models is a promise we can keep. Groq publishes no
 * price field, so the same sentence would be a claim we cannot check. The
 * picker says which one it is making.
 */
const askCaveats: Record<string, string> = Object.fromEntries(
  askProviders.map((p) => [p.id, freeClaimCaveat(p.id)]).filter(([, v]) => Boolean(v)),
) as Record<string, string>;
const askCaveatJson = JSON.stringify(askCaveats);

/** Just the host, so the byline says "originally at old.example.org" rather
 *  than printing a whole URL a second time. Falls back to the raw string when
 *  the stored value will not parse. */
function hostOf(url: string): string {
  try {
    return new URL(url).host.replace(/^www\./, '');
  } catch {
    return url.slice(0, 40);
  }
}

const title = isViewingOld ? `${post.title} (revision ${view.current.versionNumber})` : post.title;
const description = post.seoDescription || stripInline(post.dek);

/** An answered Ask is its own share object. The unfurl uses the citation card
 *  (quotes from this post), not the living-diff card, so a pasted question
 *  looks like research rather than a changelog. Rate-limited responses are
 *  not answers and must not become cards.
 *
 *  The card is chosen from the *quotes*, never the model prose. A card quoting
 *  a generated summary would spread something that can go stale independently of
 *  the post; the quotes are the post, so they stay true as long as the revision
 *  does. */
const askShareable = Boolean(
  askResult && citationIsShareable({ matched: askResult.matched, error: askResult.error }),
);
/* `askQuery`, not the raw param, so the title cannot carry markup. Astro escapes
   it for the HTML, so this is cosmetic rather than a hole — but a browser tab
   reading `</script><script>alert(1)</script>` is a bad advertisement for the
   product, and the tab is not somewhere an escape sequence helps. */
const shareTitle = askShareable ? `“${cleanAskQuestion(askQuery)}” — ${post.title}` : title;
const shareDescription = askShareable
  ? citationShareText(askResult!.passages) || description
  : description;
const shareImage = askShareable
  ? citationOgPath(post.slug, askQuery)
  : `/og/${post.slug}-diff.png`;
const askShareHref = askShareable ? citationSharePath(post.slug, askQuery) : null;

const diffByBlock = Object.fromEntries(view.diff.map((d) => [d.blockId, d.segments]));
const changeByBlock = Object.fromEntries(view.diff.map((d) => [d.blockId, d.status]));

const jsonLd = [
  {
    '@type': 'Article',
    headline: post.title,
    description,
    datePublished: new Date(post.publishedAt ?? post.createdAt).toISOString(),
    dateModified: new Date(view.current.createdAt).toISOString(),
    author: { '@type': 'Person', name: post.authorName },
    isAccessibleForFree: true,
    version: view.current.versionNumber,
    ...(post.topicName ? { articleSection: post.topicName } : {}),
  },
  { '@type': 'Person', name: post.authorName, url: `/a/${post.authorHandle}` },
  ...(askShareable
    ? [
        {
          '@type': 'QAPage',
          url: new URL(askShareHref!, Astro.url).href,
          mainEntity: {
            '@type': 'Question',
            name: askQuery,
            ...(askResult!.matched
              ? {
                  acceptedAnswer: {
                    '@type': 'Answer',
                    // The quotes, not the model prose. Structured data is the one
                    // place a generated summary would outlive its grounding: a
                    // crawler that caches this answer keeps it after the
                    // article has been revised out from under it.
                    text: askResult!.passages.map((p) => p.quote).join('\n\n'),
                  },
                }
              : {}),
          },
        },
      ]
    : []),
];
---

<Base title={shareTitle} description={shareDescription} ogType="article" ogImage={shareImage} prefs={prefs} jsonLd={jsonLd}>
  <link rel="webmention" href={`/w/${post.slug}/webmention.xml`} />
  <link rel="pingback" href={`/w/${post.slug}/webmention.xml`} />
  <article data-depth-host data-depth={depth} data-post-id={post.id} data-version={view.current.versionNumber}>
    <header class="shell border-b border-rule pt-10 pb-8">
      <div class="article-body">
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
          <StatusBadge status={post.status} />
          {
            /* An author looking at their own seedling needs a way back into it.
               The badge says UNPUBLISHED and nothing else on the page offers an
               exit, so the draft was a place a writer could only leave by
               remembering the editor URL. */
            isPostAuthor && (
              <a href={`/studio/edit/${post.slug}`} class="meta no-underline hover:text-accent">
                Edit draft →
              </a>
            )
          }
          {post.topicName && <a href="/topics" class="meta no-underline hover:text-ink">{post.topicName}</a>}
          <span class="meta">{longDate(post.publishedAt)}</span>
          {
            /* Where this post used to live. Years of other people's links point
               at the old address, and the least we can do for someone who
               followed one is tell them where they have landed. */
            post.originalUrl && (
              <a href={post.originalUrl} rel="nofollow noopener" target="_blank" class="meta no-underline hover:text-ink">
                originally at {hostOf(post.originalUrl)}
              </a>
            )
          }
          {
            view.current.versionNumber > 1 && (
              <span class="meta">
                revised {view.current.versionNumber}× · {shortAgo(view.current.createdAt)}
              </span>
            )
          }
        </div>

        <h1 class="mt-5 text-3xl">{post.title}</h1>
        {post.dek && <p class="mt-4 text-[1.125rem] leading-relaxed text-ink-2">{post.dek}</p>}

        <p class="mt-5 text-[0.9375rem] text-ink-3">
          <a href={`/a/${post.authorHandle}`} class="text-ink-2 no-underline hover:text-accent">{post.authorName}</a>
          {
            post.annotationTotal > 0 && (
              <>
                {' · '}
                <a href="#marginalia" class="text-ink-2 no-underline hover:text-accent">
                  {plural(post.annotationTotal, 'note')} in the margin
                </a>
              </>
            )
          }
          {reviewed && <span> · reviewed {reviewed}</span>}
          <span data-presence aria-hidden="true"></span>
        </p>
      </div>
    </header>
    <script is:inline define:vars={{ askCaveatJson }}>
  (() => {
    /* Fill the model box from the live catalogue when a provider is chosen.
       A text input with a datalist rather than a <select>: catalogues churn
       daily, and a stale hardcoded list is how Ask ended up calling a model that
       had been withdrawn. Whatever is typed is sent as-is, so an unlisted model
       still works.

       Deferred to DOMContentLoaded on purpose. This script is emitted in the
       article header while the picker it drives is rendered further down the
       page, so at parse time `getElementById` returns null and the whole thing
       silently does nothing — which looks exactly like a broken endpoint. */
    const start = () => {
      const root = document.querySelector('[data-ask-prefs]');
      const provider = document.getElementById('ask-provider');
      const model = document.getElementById('ask-model');
      const options = document.querySelector('[data-model-options]');
      const caveat = document.querySelector('[data-ask-caveat]');
      if (!root || !provider || !model || !options) return;

      /* Tell the reader when this provider cannot actually tell us which models
         are free, instead of letting "free" imply a guarantee. */
      let notes = {};
      try {
        notes = JSON.parse(askCaveatJson || '{}');
      } catch {}
      function paintCaveat() {
        if (!caveat) return;
        const text = provider.value ? notes[provider.value] : '';
        caveat.textContent = text ?? '';
        caveat.hidden = !text;
      }
      provider.addEventListener('change', paintCaveat);
      paintCaveat();

      let token = 0;
      async function load() {
        const id = provider.value;
        options.innerHTML = '';
        if (!id) return;
        const mine = ++token;
        try {
          const res = await fetch(`/api/models?provider=${encodeURIComponent(id)}`, {
            headers: { accept: 'application/json' },
          });
          if (!res.ok) return;
          const body = await res.json();
          if (mine !== token) return;
          for (const m of body.models ?? []) {
            const opt = document.createElement('option');
            opt.value = m.id;
            opt.label = m.free ? `${m.label} (free)` : m.label;
            options.appendChild(opt);
          }
        } catch {
          /* Offline, or the catalogue is down: automatic still works. */
        }
      }
      provider.addEventListener('change', load);
      if (provider.value) load();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', start, { once: true });
    } else {
      start();
    }
  })();
</script>

<script is:inline define:vars={{ postId: post.id }}>
      (() => {
        /* Presence heartbeat: anonymous, silent, ambient. Beats while the page
           is visible; the count next to the byline updates from the same
           endpoint. Nothing here identifies anyone — the server only ever
           counts, and a failed beat changes nothing on screen. */
        const slot = document.querySelector('[data-presence]');
        if (!slot) return;
        const paint = (n) => {
          slot.textContent = n >= 2 ? ` · ${n} reading now` : '';
        };
        const beat = async () => {
          try {
            await fetch('/api/presence', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ postId }),
              keepalive: true,
            });
            const res = await fetch(`/api/presence?postId=${encodeURIComponent(postId)}`);
            if (!res.ok) return;
            const json = await res.json();
            if (typeof json.readers === 'number') paint(json.readers);
          } catch {
            // Ambient. Never break the page over it.
          }
        };
        const tick = () => {
          if (document.visibilityState === 'visible') void beat();
        };
        void beat();
        window.setInterval(tick, 30000);
        document.addEventListener('visibilitychange', tick);
      })();
    </script>

    <div class="shell">
      <div class="article-body mt-6 space-y-3">
        {
          hasChangesSince && !isViewingOld && (
            <div class="border border-accent bg-accent-soft px-4 py-3">
              <p class="text-[0.9375rem]">
                <strong class="font-medium">This post has changed since you read it.</strong>{' '}
                <span class="text-ink-2">
                  You last saw version {lastSeen!.versionNumber}. {plural(stats.changed, 'change')} since.
                </span>
              </p>
              <a
                href={`?rev=${view.current.versionNumber}`}
                class="meta mt-2 inline-block text-accent no-underline hover:underline"
              >
                See what changed →
              </a>
            </div>
          )
        }

        {
          noteError && (
            <div
              class="border border-danger px-4 py-3"
              role="alert"
              id={errorNoteId ? `error-for-note-${errorNoteId}` : undefined}
            >
              <p class="text-[0.9375rem] text-danger">{noteError}</p>
              <p class="meta mt-1">Nothing was changed.</p>
            </div>
          )
        }

        {
          isViewingOld && (
            <div class="border border-ochre px-4 py-3">
              <p class="text-[0.9375rem]">
                <strong class="font-medium">Viewing revision {view.current.versionNumber}</strong>{' '}
                <span class="text-ink-2">
                  — {view.compared
                    ? `changes shown against revision ${view.compared.versionNumber}`
                    : 'the first published version'}
                  . Written {ago(view.current.createdAt)}.
                </span>
              </p>
              <p class="meta mt-2">{view.current.changeSummary}</p>
              <a href={`/w/${post.slug}`} class="meta mt-2 inline-block text-ochre no-underline hover:underline">
                ← Back to the current version
              </a>
            </div>
          )
        }
      </div>
    </div>

    <div class="shell mt-8">
      <div class="article-body">
        <Prose
          blocks={doc}
          diffSegments={isViewingOld && view.compared ? diffByBlock : undefined}
          changeStatus={isViewingOld && view.compared ? changeByBlock : undefined}
          notes={notesByBlock}
          replies={repliesByParent}
          postSlug={post.slug}
          postId={post.id}
          canAccept={isPostAuthor}
          returnTo={returnTo}
          mine={mineReactions}
          myHighlights={myBlockHighlights}
        />
      </div>
    </div>

    <div class="shell mt-16">
      <div class="article-body space-y-10">
        <section aria-labelledby="depth-heading" class="border-t border-rule pt-6">
          <h2 id="depth-heading" class="meta mb-3">How deep do you want this?</h2>
          {!Astro.cookies.has(DEPTH_COOKIE) && (
            <p class="mb-3 max-w-xl border-l-2 border-accent pl-3 text-[0.9375rem] leading-relaxed text-ink-2">
              First time here? <strong class="font-medium text-ink">Set your depth once</strong> and
              every post honors it — skim the argument, read it properly, or take the footnotes too.
            </p>
          )}
          <DepthDial
            initial={depth}
            minutes={minutes}
            hasUnderstand={hasUnderstand}
            hasMaster={hasMaster}
          />
        </section>

        <section aria-labelledby="revisions-heading" class="border-t border-rule pt-6">
          <div class="flex items-baseline justify-between gap-4">
            <h2 id="revisions-heading" class="meta">Revision history</h2>
            {
              isViewingOld && (
                <a href={`/w/${post.slug}`} class="meta text-accent no-underline hover:underline">
                  current →
                </a>
              )
            }
          </div>

          {
            isViewingOld && view.compared && stats.changed > 0 && (
              <p class="mt-2 text-[0.9375rem] text-ink-2">
                {[
                  stats.modified > 0 && `${plural(stats.modified, 'paragraph')} rewritten`,
                  stats.added > 0 && `${stats.added} added`,
                  stats.removed > 0 && `${stats.removed} removed`,
                ]
                  .filter(Boolean)
                  .join(' · ')}
              </p>
            )
          }

          <ol class="mt-4 space-y-3">
            {
              versions.map((v) => {
                const isViewing = v.id === view.current.id;
                const isHead = v.id === post.currentVersionId;
                return (
                  <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1 border-b border-rule pb-3 last:border-b-0">
                    <span class="meta w-8 tabular-nums">v{v.versionNumber}</span>
                    <a
                      href={`?rev=${v.versionNumber}`}
                      class:list={[
                        'text-[0.9375rem] no-underline',
                        isViewing ? 'text-ink' : 'text-ink-2 hover:text-accent',
                      ]}
                      aria-current={isViewing ? 'true' : undefined}
                    >
                      {v.changeSummary}
                    </a>
                    <span class="meta">{shortAgo(v.createdAt)}</span>
                    {v.isMajor && !isHead && <span class="meta text-ochre">major</span>}
                    {isHead && <span class="meta text-pine">current</span>}
                    {isViewing && !isHead && <span class="meta text-accent">viewing</span>}
                  </li>
                );
              })
            }
          </ol>
        </section>

        {post.visibility === 'public' && post.publishedAt && !isViewingOld && (
          <section aria-label="Keep this post" class="border-t border-rule pt-6">
            <div class="flex flex-wrap items-baseline gap-x-5 gap-y-2">
              <form method="post" action="/api/memory" class="contents">
                <input type="hidden" name="action" value="save" />
                <input type="hidden" name="postId" value={post.id} />
                <input type="hidden" name="returnTo" value={returnTo} />
                <button
                  type="submit"
                  aria-pressed={isSavedNow}
                  class="meta text-ink-3 no-underline hover:text-ink"
                >
                  {isSavedNow ? 'Saved ✓ — in your reading' : 'Save for later'}
                </button>
              </form>
              {identity.userId && ownLists.length > 0 && (
                <details class="note-disclosure">
                  <summary class="meta cursor-pointer text-ink-3 hover:text-ink">Add to a list</summary>
                  <form method="post" action="/api/lists" class="mt-2 flex flex-wrap items-center gap-2">
                    <input type="hidden" name="action" value="add" />
                    <input type="hidden" name="postId" value={post.id} />
                    <input type="hidden" name="returnTo" value={returnTo} />
                    <label class="sr-only" for="add-to-list">
                      Choose a list
                    </label>
                    <select
                      id="add-to-list"
                      name="listId"
                      class="border border-rule bg-paper px-2 py-1 text-[0.8125rem] focus:border-accent focus:outline-none"
                    >
                      {ownLists.map((l) => (
                        <option value={l.id}>
                          {l.title}
                          {l.isPublic ? '' : ' (private)'}
                        </option>
                      ))}
                    </select>
                    <button
                      type="submit"
                      class="border border-rule px-2 py-1 text-[0.8125rem] text-ink-3 transition-colors hover:border-ink hover:text-ink"
                    >
                      Add
                    </button>
                  </form>
                </details>
              )}
              {identity.userId ? (
                <form method="post" action="/api/fork" class="flex flex-wrap items-baseline gap-x-3 gap-y-2">
                  <input type="hidden" name="postId" value={post.id} />
                  <input type="hidden" name="returnTo" value={returnTo} />
                  <button type="submit" class="meta text-ink-3 no-underline hover:text-ink">
                    Fork this post →
                  </button>
                  <span class="text-[0.8125rem] text-ink-3">
                    Your own seedling, starting from this text. The ancestor is credited permanently.
                  </span>
                </form>
              ) : (
                <p class="text-[0.8125rem] text-ink-3">
                  <a href="/write#handle" class="text-ink-3 underline hover:text-ink">
                    Claim a handle
                  </a>{' '}
                  to fork this post into your own seedling.
                </p>
              )}
            </div>
          </section>
        )}

        <section id="marginalia" aria-labelledby="marginalia-heading" class="border-t border-rule pt-6">
          <div class="flex flex-wrap items-baseline justify-between gap-3">
            <h2 id="marginalia-heading" class="meta">Marginalia</h2>
            {
              myNoteCount > 0 && (
                <a href="#marginalia" class="meta no-underline hover:text-ink">
                  {plural(myNoteCount, 'note')} of yours on this post
                </a>
              )
            }
          </div>

          <p class="mt-2 max-w-xl text-[0.9375rem] leading-relaxed text-ink-2">
            {
              allNotes.length === 0
                ? 'No notes yet. Select any sentence in the text to leave the first one — no account needed.'
                : `${plural(allNotes.length, 'note')} from ${plural(participants, 'reader')}, attached to specific sentences. Select any sentence in the text to add yours.`
            }
          </p>

          {
            allNotes.some((n) => n.onOlderRevision) && (
              <p class="mt-2 max-w-xl text-[0.875rem] leading-relaxed text-ochre">
                {`${plural(staleNotes, 'note')} here ${verb(staleNotes, 'argues', 'argue')} with an earlier revision of this post and ${verb(staleNotes, 'links', 'link')} to it.`}
              </p>
            )
          }

          {
            allNotes.length > 1 && (
              <nav aria-label="Order the notes" class="mt-3 flex flex-wrap items-center gap-2">
                <span class="meta">Order</span>
                {NOTE_SORTS.map((s) => (
                  <a
                    href={`?notes=${s}`}
                    aria-current={noteSort === s ? 'true' : undefined}
                    class:list={[
                      'meta no-underline transition-colors',
                      noteSort === s ? 'text-accent' : 'text-ink-3 hover:text-ink',
                    ]}
                  >
                    {s}
                  </a>
                ))}
                {noteSort !== 'newest' && (
                  <a href={Astro.url.pathname} class="meta text-ink-3 no-underline hover:text-ink">
                    reset
                  </a>
                )}
              </nav>
            )
          }
        </section>

        <section id="ask" aria-labelledby="ask-heading" class="border-t border-rule pt-6">
          <h2 id="ask-heading" class="meta">Ask this article</h2>
          <p class="mt-2 max-w-xl text-[0.9375rem] leading-relaxed text-ink-2">
            Answers are quotes from this post, not generated text — so they can
            be wrong by omission but never by invention. What it does not cover,
            it says so. If you have brought your own model key, a model
            summarizes those same quotes, and the quotes stay the source of
            truth.
          </p>
          <form id="ask-form" method="get" action="#ask" class="mt-4 flex max-w-xl gap-2" role="search">
            <label class="sr-only" for="ask-q">
              Ask this article
            </label>
            <input
              id="ask-q"
              name="ask"
              type="search"
              value={askQuery}
              required
              minlength={3}
              maxlength={500}
              autocomplete="off"
              placeholder="What does it say about…?"
              class="min-w-0 flex-1 border border-rule bg-paper px-3 py-2 text-[0.9375rem] focus:border-accent focus:outline-none"
            />
            <button
              type="submit"
              class="shrink-0 border border-ink bg-ink px-4 py-2 text-[0.9375rem] text-paper transition-colors hover:border-accent hover:bg-accent"
            >
              Ask
            </button>
          </form>

          {/* Pick a transport and a model. This is a preference, not a
              requirement: leave it on automatic and the site picks the cheapest
              working model, which is what almost everyone should do. It exists
              because a reader who paid for their own key should be able to spend
              it here, and because "which model answered this" is a question the
              reader is entitled to ask before they read the answer. */}
          {
            askProviders.length > 0 && (
              <details class="mt-3 max-w-xl" data-ask-prefs>
                <summary class="meta cursor-pointer text-ink-3 hover:text-ink">
                  Answer with a specific model
                </summary>
                <div class="mt-2 flex flex-wrap items-end gap-2">
                  <div class="min-w-0 flex-1">
                    <label class="meta block" for="ask-provider">
                      Provider
                    </label>
                    <select
                      id="ask-provider"
                      name="askProvider"
                      form="ask-form"
                      class="mt-1 w-full border border-rule bg-paper px-3 py-2 text-[0.9375rem] focus:border-accent focus:outline-none"
                    >
                      <option value="">Automatic (cheapest working model)</option>
                      {askProviders.map((p) => (
                        <option value={p.id} selected={p.id === askProvider}>
                          {p.label}
                          {readerHasKey.has(p.id) ? ' — your key' : ''}
                        </option>
                      ))}
                    </select>
                  </div>
                  <div class="min-w-0 flex-1" data-model-slot>
                    <label class="meta block" for="ask-model">
                      Model
                    </label>
                    <input
                      id="ask-model"
                      name="askModel"
                      form="ask-form"
                      list="ask-model-options"
                      value={askModel}
                      maxlength="120"
                      placeholder="Automatic"
                      autocomplete="off"
                      class="mt-1 w-full border border-rule bg-paper px-3 py-2 text-[0.9375rem] focus:border-accent focus:outline-none"
                    />
                    <datalist id="ask-model-options" data-model-options />
                  </div>
                </div>
                <p class="mt-1.5 text-[0.75rem] leading-snug text-ink-3">
                  Your key is used for your provider if you added one, otherwise the
                  site's. Automatic stays on free-tier models only.
                </p>
                <p class="mt-1 text-[0.75rem] leading-snug text-ink-3" data-ask-caveat hidden></p>
              </details>
            )
          }

          {askAsked && (
            <div class="mt-5 max-w-xl border border-rule bg-surface p-4">
              <p class="meta">{askResult!.matched ? 'Citation' : 'You asked'}</p>
              <p class="mt-1 text-[0.9375rem] font-medium">“{askResult!.question}”</p>
              {askResult!.error ? (
                /* Never dress a rate limit up as a gap in the article. Telling a
                   reader their question is "not covered yet" when the truth is
                   that they have hit a quota would put a lie in the writer's
                   confusion dashboard and send them off to write something that
                   is already answered. */
                <p class="border-l-2 border-rule-strong pl-3 text-[0.9375rem] leading-relaxed text-ink-2" role="status">
                  {askResult!.error}
                </p>
              ) : askResult!.matched ? (
                <>
                  {askResult!.answer && (
                    <>
                      <p class="meta mt-4">In short</p>
                      <p class="mt-2 text-[0.9375rem] leading-relaxed">{askResult!.answer}</p>
                    </>
                  )}
                  <p class="meta mt-4">The post says</p>
                  <div class="mt-2 space-y-4">
                    {askResult!.passages.map((p) => (
                      <figure class="border-l-2 border-accent pl-3">
                        <blockquote class="text-[0.9375rem] leading-relaxed text-ink-2" set:html={p.quote} />
                        <figcaption class="meta mt-1.5">
                          <a href={`#block-${p.blockId}`} class="no-underline hover:text-ink">
                            Read in context →
                          </a>
                        </figcaption>
                      </figure>
                    ))}
                  </div>
                  {askResult!.answer && (
                    <p class="meta mt-4">
                      Summarized from the quotes above, which are the source of
                      truth — the model only read these, never outside sources.
                      {askResult!.modelLabel ? ` (${askResult!.modelLabel})` : ''}
                    </p>
                  )}
                </>
              ) : (
                <p class="mt-3 border-l-2 border-ochre pl-3 text-[0.9375rem] leading-relaxed text-ink-2">
                  This isn't covered in the article — not yet, anyway. The
                  question has been logged against the post, which is how the
                  writer learns what to write next.
                </p>
              )}
              {askShareHref && (
                <p class="meta mt-4">
                  <a href={askShareHref} class="no-underline hover:text-ink">
                    Share this citation →
                  </a>
                </p>
              )}
            </div>
          )}

          {/* The stress-tester. Separate from Ask above rather than a mode of it,
              because it is the opposite act: Ask serves the reader's question,
              this attacks the post's own claims. Putting them in one box would
              imply the reader is asking about themselves. */}
          <div class="mt-8 border-t border-rule pt-6">
            <h3 class="text-[1.0625rem] font-medium">Try to break this argument</h3>
            <p class="mt-2 max-w-xl text-[0.9375rem] leading-relaxed text-ink-2">
              The claims this post makes most concretely — the ones with numbers,
              absolutes or prescriptions in them — put to a model that has read
              only the sentence in question. Every objection quotes the post, and
              a claim nothing can be said against is reported as standing.
            </p>
            {!stressAsked ? (
              <form method="get" action="#stress" class="mt-3">
                {askQuery && <input type="hidden" name="ask" value={askQuery} />}
                {askProvider && <input type="hidden" name="askProvider" value={askProvider} />}
                {askModel && <input type="hidden" name="askModel" value={askModel} />}
                <button
                  type="submit"
                  name="stress"
                  value="1"
                  class="border border-ink bg-ink px-4 py-2 text-[0.9375rem] text-paper transition-colors hover:border-accent hover:bg-accent"
                >
                  Stress-test the argument
                </button>
                <p class="meta mt-2">
                  {askProviders.length > 0
                    ? "Costs a few model calls against your key or the site's."
                    : 'No model key is configured, so this will pair each claim with its passage and report nothing it can ground.'}
                </p>
              </form>
            ) : (
              <div class="mt-4 max-w-2xl">
                {stressResult!.error ? (
                  <p class="border-l-2 border-ochre pl-3 text-[0.9375rem] leading-relaxed text-ink-2" role="status">
                    {stressResult!.error}
                  </p>
                ) : stressResult!.claims.length === 0 ? (
                  <p class="border-l-2 border-rule-strong pl-3 text-[0.9375rem] leading-relaxed text-ink-2">
                    Nothing to attack.
                  </p>
                ) : (
                  <>
                    <ol class="space-y-6">
                      {stressResult!.claims.map((c) => (
                        <li class="border-l-2 border-rule-strong pl-3">
                          <p class="meta">The claim</p>
                          <p class="mt-1 text-[0.9375rem] leading-relaxed">“{c.quote}”</p>
                          {c.objection ? (
                            <>
                              <p class="meta mt-3">The objection</p>
                              <p class="mt-1 text-[0.9375rem] leading-relaxed text-ink-2">
                                {c.objection}
                              </p>
                              {c.modelLabel && (
                                <p class="meta mt-2">
                                  ({c.modelLabel})
                                </p>
                              )}
                            </>
                          ) : (
                            <p class="mt-3 border-l-2 border-pine pl-3 text-[0.9375rem] leading-relaxed text-ink-2">
                              Nothing in the passage undermines this one. That is
                              a result about the argument as written, not proof it
                              is true.
                            </p>
                          )}
                          <p class="meta mt-2">
                            <a href={`#block-${c.blockId}`} class="no-underline hover:text-ink">
                              Read the claim in context →
                            </a>
                          </p>
                        </li>
                      ))}
                    </ol>
                    <p class="meta mt-5">
                      Every objection above was produced by a model that saw only
                      the quoted sentence — no outside knowledge, no other
                      article. A refusal to engage is reported rather than
                      hidden, because an argument that survives this is not
                      thereby proven.
                    </p>
                  </>
                )}
              </div>
            )}
          </div>
        </section>

        {myHighlightCount > 0 && (
          <section aria-labelledby="hl-heading" class="border-t border-rule pt-6">
            <h2 id="hl-heading" class="text-xl">
              Your highlights{' '}
              <span class="meta">· {plural(myHighlightCount, 'span')}</span>
            </h2>
            <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-2">
              Private to you. Writers see which spans readers marked, never who
              marked them or that you did.
            </p>
            <ol class="mt-4 space-y-4">
              {myHighlights.map((h) => (
                <li class="border-l-2 border-accent pl-3">
                  <p class="text-[0.9375rem] leading-relaxed text-ink-2">{h.text}</p>
                  <p class="meta">
            <a href={`/w/${post.slug}`} class="no-underline hover:text-ink">
              {post.title}
            </a>{' '}
            · {ago(h.createdAt)}
          </p>
                  {/* A highlight you cannot take back is a decision made for you.
                      This posts the same span back to the toggle endpoint, which
                      removes it, and drops you back here on the redirect. */}
                  {h.postId === post.id && (
                    <form method="post" action="/api/highlight" class="mt-1.5">
                      <input type="hidden" name="postId" value={post.id} />
                      <input type="hidden" name="blockId" value={h.blockId} />
                      <input type="hidden" name="text" value={h.text} />
                      <input type="hidden" name="returnTo" value={returnTo} />
                      <button type="submit" class="meta text-ink-3 hover:text-danger">
                        Remove this highlight
                      </button>
                    </form>
                  )}
                </li>
              ))}
            </ol>
          </section>
        )}

        {/* Where this post sits. Only when it sits anywhere: an unlinked post
            would render an axis with one tick on it, which says nothing. */}
        {neighbourhood && neighbourhood.edges.length > 0 && (
          <section aria-labelledby="neighbours-heading" class="border-t border-rule pt-6">
            <h2 id="neighbours-heading" class="text-xl">Where this sits</h2>
            <p class="mt-2 max-w-prose text-[0.9375rem] leading-relaxed text-ink-2">
              {(() => {
                /* Written out rather than assembled from fragments: the first
                   version produced "leans on 1 other one" because the noun was
                   interpolated separately from the number it belonged to. */
                const leans = neighbourhood.leansOn.length;
                const used = neighbourhood.isLeanedOn.length;
                const leanedOn =
                  leans === 0
                    ? 'It leans on nothing else here.'
                    : leans === 1
                      ? 'It leans on 1 other post.'
                      : `It leans on ${leans} other posts.`;
                const pickedUp =
                  used === 0
                    ? ' Nothing has picked it up yet.'
                    : used === 1
                      ? ' One post has picked it up since.'
                      : ` ${used} posts have picked it up since.`;
                return leanedOn + pickedUp;
              })()}{' '}
              Oldest at the top, so a claim resting on something written after it
              would be visible as an arc running upward.
            </p>
            <div class="mt-4 max-w-2xl">
              <Neighbourhood
                focus={neighbourhood.node}
                nodes={neighbourhood.nodes}
                edges={neighbourhood.edges}
              />
            </div>
          </section>
        )}

        {
          nextReads.length > 0 && (
            <div class="border-t border-rule pt-6">
              <NextReads items={nextReads} />
            </div>
          )
        }

        <section aria-labelledby="revise-heading" class="border-t border-rule pt-6">
          <h2 id="revise-heading" class="text-xl">When this changes</h2>
          <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-2">
            {
              view.current.versionNumber > 1
                ? `This post has been revised ${view.current.versionNumber - 1} ${view.current.versionNumber === 2 ? 'time' : 'times'}. Leave an address and you will hear the next time it moves — once, and only for a substantial change, not a typo.`
                : 'Leave an address and you will hear if this post is ever substantially revised — once, and only when it actually changes.'
            }
          </p>
          {subscribeState === 'on' ? (
            <p class="mt-3 border-l-2 border-accent pl-3 text-[0.9375rem] text-ink-2" role="status">
              You will hear when it changes. If you did not expect this, it is
              already done and the address was not stored anywhere else.
            </p>
          ) : subscribeState === 'off' ? (
            <p class="mt-3 border-l-2 border-rule-strong pl-3 text-[0.9375rem] text-ink-2" role="status">
              Unsubscribed. You will not hear about further changes.
            </p>
          ) : (
            <form method="post" action="/api/subscribe" class="mt-4 flex max-w-md flex-wrap items-end gap-2">
              <input type="hidden" name="postId" value={post.id} />
              <input type="hidden" name="returnTo" value={returnTo} />
              <div class="min-w-0 flex-1">
                <label class="meta block" for="rev-email">Email</label>
                <input
                  id="rev-email"
                  name="email"
                  type="email"
                  required
                  autocomplete="email"
                  placeholder="you@example.com"
                  class="mt-1 w-full border border-rule bg-paper px-3 py-2 text-[0.9375rem] focus:border-accent focus:outline-none"
                />
              </div>
              <button
                type="submit"
                class="shrink-0 border border-ink bg-ink px-3 py-2 text-[0.9375rem] text-paper transition-colors hover:border-accent hover:bg-accent"
              >
                Tell me
              </button>
              {subscribeState === 'bad-email' && (
                <p class="w-full text-[0.875rem] text-danger" role="alert">
                  That does not look like an email address.
                </p>
              )}
            </form>
          )}
        </section>
      </div>
    </div>

    <Marginalia
      postId={post.id}
      versionId={view.current.id}
      canWriteAuthorNote={isPostAuthor}
      signedInAs={identity.handle}
    />

    {
      (newer || older) && (
        <nav aria-label="Adjacent writing" class="shell border-t border-rule py-8">
          <div class="grid gap-6 sm:grid-cols-2">
            {older && (
              <a href={`/w/${older.slug}`} class="group block no-underline">
                <p class="meta">← Previous</p>
                <p class="mt-1 text-[1.0625rem] text-ink group-hover:text-accent">{older.title}</p>
              </a>
            )}
            {newer && (
              <a href={`/w/${newer.slug}`} class="group block no-underline sm:text-right">
                <p class="meta">Next →</p>
                <p class="mt-1 text-[1.0625rem] text-ink group-hover:text-accent">{newer.title}</p>
              </a>
            )}
          </div>
        </nav>
      )
    }
  </article>

  {
    mentions.length > 0 && (
      <aside class="shell mt-12 max-w-2xl border-t border-rule pt-8" aria-labelledby="mentions-h">
        <h2 id="mentions-h" class="text-xl">
          Linked from {mentions.length} other {mentions.length === 1 ? 'page' : 'pages'}
        </h2>
        <ul class="mt-4 divide-y divide-rule border-y border-rule">
          {mentions.map((m) => (
            <li class="py-3">
              <a href={m.source} rel="noopener nofollow ugc" class="group block no-underline">
                <p class="text-[0.9375rem] group-hover:text-accent">
                  {m.sourceTitle || `A page on ${m.host}`}
                </p>
                <p class="meta mt-1">
                  {m.kind}
                  {' · '}
                  {m.host}
                  {/* An unverified mention is somebody's assertion that they linked
                      here. Showing it as fact would let anyone claim credit for
                      linking, so it is marked rather than asserted. */}
                  {m.verified ? '' : ' · unverified link'}
                </p>
              </a>
            </li>
          ))}
        </ul>
        <p class="meta mt-3">
          <a href={`/w/${post.slug}/webmention.xml`} class="underline decoration-rule underline-offset-4 hover:decoration-accent">
            This post&rsquo;s webmention feed →
          </a>
        </p>
      </aside>
    )
  }
</Base>

<script>
  import installReachBeacon from '../../lib/reach-beacon';

  // Only on the current version: drop-off against a revision nobody is reading
  // is a number about a historical artifact.
  const host = document.querySelector<HTMLElement>('[data-depth-host]');
  if (host && !new URLSearchParams(location.search).has('rev')) {
    installReachBeacon(host, '/api/telemetry');
  }
</script>
