---
import Base from '../../../layouts/Base.astro';
import StatusBadge from '../../../components/StatusBadge.astro';
import { resolvePrefs, ANON_COOKIE } from '../../../lib/prefs';
import { getIdentity } from '../../../lib/repo/auth';
import { myPostHealth } from '../../../lib/repo/studio';
import { getEmpathyReport, COHORT_FLOOR } from '../../../lib/repo/empathy';
import { getAutopsy } from '../../../lib/repo/autopsy';
import { getPostById } from '../../../lib/repo/posts';
import { simulateAudience } from '../../../lib/audience';
import { plural } from '../../../lib/format';

/**
 * Empathy analytics for one post.
 *
 * §7 asks for "where did readers think, and where did thinking break?" — and
 * explicitly refuses individual scroll heatmaps as creepy, usually wrong, and
 * aimed at the wrong fix. So this shows three aggregate signals and nothing
 * per-reader: a reach curve, the sentences that got highlighted, and the
 * confusion — unanswered questions and reader disagreement.
 *
 * Below the cohort floor it shows nothing and says how many more readers are
 * needed. A curve drawn from three people is not comprehension data.
 */

const anonId = Astro.cookies.get(ANON_COOKIE)?.value ?? crypto.randomUUID();
const prefs = resolvePrefs(Astro.cookies as never, anonId);
const identity = await getIdentity(Astro.cookies);

const slug = Astro.params.slug ?? '';
const owned = identity.userId ? await myPostHealth(identity.userId) : [];
const mine = owned.find((p) => p.slug === slug);

// The cohort floor means even a correct answer is withheld below it.
const report = mine ? await getEmpathyReport(mine.id) : null;
if (mine && !report) return new Response(null, { status: 404, statusText: 'Not found' });
/* Autopsy is text-first. Two of its three findings do not need a cohort, so
   it runs even when the curve is withheld. */
const autopsyReport = mine ? await getAutopsy(mine.id) : null;
const audience = mine
  ? simulateAudience((await getPostById(mine.id))?.blocks ?? [])
  : null;
---

<Base
  title={mine ? `Readers · ${mine.title}` : 'Readers'}
  description="Where readers reached, what they highlighted, and where thinking broke — in aggregate, never per reader."
  prefs={prefs}
  noindex
>
  <header class="shell border-b border-rule py-12">
    <div class="max-w-2xl">
      <p class="meta">Reader comprehension</p>
      {mine ? (
        <>
          <h1 class="mt-3 text-3xl">{mine.title}</h1>
          <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1">
            <StatusBadge status={mine.status} />
            <span class="meta">
              {plural(report!.cohort, 'reader')} · {plural(report!.impressions, 'open')}
            </span>
          </p>
        </>
      ) : (
        <h1 class="mt-3 text-3xl">Reader comprehension</h1>
      )}
    </div>
  </header>

  <div class="shell py-12">
    <div class="max-w-2xl space-y-14">
      {!mine && (
        <p class="text-[1.0625rem] leading-relaxed text-ink-2">
          These are your posts' reader signals. Open one from{' '}
          <a href="/studio" class="text-ink no-underline hover:text-accent">Studio →</a>
        </p>
      )}

      {
        mine && autopsyReport && (
          <section aria-labelledby="autopsy-heading">
            <h2 id="autopsy-heading" class="text-xl">Draft autopsy</h2>
            <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-2">
              Three named checks: a term used without a definition, a conclusion
              that restates the introduction, and a section that is both long
              and skipped. Advisory — a finding is a sentence to act on, not a
              score.
            </p>
            {!autopsyReport.inspected ? (
              <p class="mt-4 border-l-2 border-rule-strong pl-3 text-[0.9375rem] text-ink-2">
                This post has no body to inspect yet. The checks did not run.
              </p>
            ) : autopsyReport.findings.length === 0 ? (
              <p class="mt-4 border-l-2 border-rule-strong pl-3 text-[0.9375rem] text-ink-2">
                Nothing to report.{' '}
                {autopsyReport.jargonChecked === 1 ? '1 term' : `${autopsyReport.jargonChecked} terms`}{' '}
                checked ·{' '}
                {autopsyReport.sectionsChecked === 1 ? '1 section' : `${autopsyReport.sectionsChecked} sections`}{' '}
                measured.
              </p>
            ) : (
              <ul class="mt-4 space-y-3">
                {autopsyReport.findings.map((f) => (
                  <li class="border-l-2 border-accent pl-3">
                    <p class="text-[0.9375rem] leading-relaxed text-ink">{f.detail}</p>
                    {f.quote && (
                      <blockquote class="mt-2 text-[0.875rem] leading-relaxed text-ink-2">
                        {f.quote}
                      </blockquote>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </section>
        )
      }

      {
        mine && audience && (
          <section aria-labelledby="audience-heading">
            <h2 id="audience-heading" class="text-xl">Where an 8-year-old drops off</h2>
            <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-2">
              Three deterministic personas, no model. A grade is Flesch–Kincaid
              on that paragraph; an outsider is stopped by the same undefined
              term Draft Autopsy names. Re-run after a cut — the answer will
              not drift.
            </p>
            {audience.personas.length === 0 ? (
              <p class="mt-4 border-l-2 border-rule-strong pl-3 text-[0.9375rem] text-ink-2">
                Nothing to simulate. This post has no paragraphs yet.
              </p>
            ) : (
              <ul class="mt-4 space-y-3">
                {audience.personas.map((p) => (
                  <li class="border-l-2 border-rule-strong pl-3">
                    <p class="meta">{p.label}</p>
                    <p class="mt-1 text-[0.9375rem] leading-relaxed text-ink">{p.detail}</p>
                    {p.quote && p.dropBlockId && (
                      <blockquote class="mt-2 text-[0.875rem] leading-relaxed text-ink-2">
                        {p.quote}
                      </blockquote>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </section>
        )
      }

      {
        mine && report!.suppressed && (
          <div>
            <p class="text-[1.0625rem] leading-relaxed text-ink">
              Not enough readers yet to say anything honest.
            </p>
            <p class="mt-3 text-[0.9375rem] leading-relaxed text-ink-2">
              {report!.cohort} {report!.cohort === 1 ? 'reader has' : 'readers have'} read this;
              patterns below {COHORT_FLOOR} readers are noise, and a curve drawn
              from noise is worse than no curve. {COHORT_FLOOR - report!.cohort} more
              would show reach.
            </p>
            <p class="mt-4 border-l-2 border-rule-strong pl-3 text-[0.9375rem] text-ink-3">
              This is the same rule the privacy promise uses: a cohort of
              readers is never analysed individually, and never reported on
              when it is too small to mean anything.
            </p>
          </div>
        )
      }

      {
        mine && !report!.suppressed && (
          <>
            {report!.dropOff && (
              <section aria-labelledby="dropoff-heading">
                <h2 id="dropoff-heading" class="text-xl">Am I losing them here?</h2>
                <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-2">
                  The largest single fall in the reach curve. Readers reached
                  this paragraph, then most of them stopped:
                </p>
                <blockquote class="mt-3 border-l-2 border-accent pl-3 text-[0.9375rem] leading-relaxed text-ink-2">
                  {report!.dropOff.preview || '(a block with no text)'}
                </blockquote>
                <p class="meta mt-2">
                  {Math.round(report!.dropOff.share * 100)}% of the readers who
                  reached it did not read the next paragraph
                </p>
              </section>
            )}

            <section aria-labelledby="curve-heading">
              <h2 id="curve-heading" class="text-xl">Where readers reach</h2>
              <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-2">
                Aggregate reach per block, scaled to the most-reached block. This
                is not a scroll heatmap and there is no per-reader view to
                browse.
              </p>
              <ul class="mt-5 space-y-1.5">
                {report!.blocks.map((b) => (
                  <li class="flex items-center gap-3">
                    <span class="w-16 shrink-0 font-mono text-[0.75rem] tabular-nums text-ink-3">
                      {b.reached}
                    </span>
                    <span class="h-3 min-w-0 flex-1 bg-sunken">
                      <span
                        class="block h-3 bg-accent"
                        style={`width: ${Math.max(1, Math.round(b.relative * 100))}%`}
                      />
                    </span>
                    <span class="min-w-0 flex-1 truncate text-[0.75rem] text-ink-3">
                      {b.preview}
                    </span>
                  </li>
                ))}
              </ul>
            </section>

            {report!.hotspots.length > 0 && (
              <section aria-labelledby="hotspots-heading">
                <h2 id="hotspots-heading" class="text-xl">What got highlighted</h2>
                <ol class="mt-4 space-y-3">
                  {report!.hotspots.map((h) => (
                    <li class="border-b border-rule pb-3 last:border-b-0">
                      <p class="meta">{plural(h.readers, 'reader')}</p>
                      <p class="mt-1 text-[0.9375rem] leading-relaxed text-ink-2">{h.text}</p>
                    </li>
                  ))}
                </ol>
              </section>
            )}

            {report!.confusion.length > 0 && (
              <section aria-labelledby="confusion-heading">
                <h2 id="confusion-heading" class="text-xl">Where thinking broke</h2>
                <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-2">
                  Questions this post could not answer, and where readers argued
                  with each other or with you. These are the to-do list.
                </p>
                <ul class="mt-4 space-y-3">
                  {report!.confusion.map((c, i) => (
                    <li class="border-l-2 border-ochre pl-3">
                      {c.kind === 'unanswered_ask' && c.question ? (
                        <>
                          <p class="text-[0.9375rem] leading-relaxed text-ink">
                            “{c.question}”
                          </p>
                          <p class="meta mt-1">
                            asked {c.count === 1 ? 'once' : `${c.count} times`} · not covered
                            in this post
                          </p>
                        </>
                      ) : (
                        <p class="text-[0.9375rem] text-ink-2">
                          {c.kind === 'disagreement' ? 'Readers disagreed' : 'Readers offered corrections'}{' '}
                          — {plural(c.count, 'note')} in the margin
                        </p>
                      )}
                      {i < report!.confusion.length - 1 && <span class="sr-only">,</span>}
                    </li>
                  ))}
                </ul>
              </section>
            )}

            <p class="border-t border-rule pt-6 text-[0.9375rem] text-ink-2">
              <a href="/studio" class="text-ink no-underline hover:text-accent">
                Back to Studio →
              </a>
            </p>
          </>
        )
      }
    </div>
  </div>
</Base>
