---
import Base from '../layouts/Base.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { resolvePrefs, ANON_COOKIE } from '../lib/prefs';
import { getIdentity } from '../lib/repo/auth';
import { getOpenAsks, listCaptures, myPostHealth, synthesizeInbox } from '../lib/repo/studio';
import { getListShareToken, myReadingLists } from '../lib/repo/taxonomy';
import { getCollaborators } from '../lib/repo/collaborators';
import { getPostById, suggestLinks } from '../lib/repo/posts';
import { lintCitations, type LintReport } from '../lib/lint';
import { driftScore, featuresOfBlocks, readVoice, type VoiceProfile } from '../lib/repo/voice';
import { getReportedNotes } from '../lib/repo/annotations';
import { buildDigest, getDigestSubscribers } from '../lib/repo/digest';
import { ago, plural } from '../lib/format';

/**
 * Writer Studio, v1.
 *
 * Only claimed writers get in — an anonymous browser has no inbox, no posts,
 * and no readers to be confused, so without a handle the page says so and
 * points at claiming one instead of rendering an empty studio. Three sections,
 * each a working loop rather than a dashboard: capture fragments, graduate
 * them to seedlings, and see which posts need attention ordered by neglect.
 */

const anonId = Astro.cookies.get(ANON_COOKIE)?.value ?? crypto.randomUUID();
const prefs = resolvePrefs(Astro.cookies as never, anonId);
const identity = await getIdentity(Astro.cookies);

const studioError = Astro.url.searchParams.get('studioError');

const captures = identity.userId ? await listCaptures(identity.userId, 'inbox') : [];
const seeds = identity.userId ? await listCaptures(identity.userId, 'seed') : [];
const health = identity.userId ? await myPostHealth(identity.userId) : [];

/* Citation lint over each post's current body. Advisory by construction: a
   number with no source is a question, not a verdict, and the page says so. */
const lintByPost = new Map<string, LintReport>();
if (identity.userId) {
  for (const post of health) {
    const full = await getPostById(post.id);
    if (full) lintByPost.set(post.id, lintCitations(full.blocks));
  }
}

const openAsksByPost = new Map<string, Awaited<ReturnType<typeof getOpenAsks>>>();
if (identity.userId) {
  for (const post of health.filter((p) => p.openAsks > 0).slice(0, 5)) {
    openAsksByPost.set(post.id, await getOpenAsks(post.id, identity.userId));
  }
}
const flagged = identity.userId ? await getReportedNotes(identity.userId) : [];
const digestPreview = identity.userId
  ? {
      ...(await buildDigest(Date.now() - 7 * 86_400_000)),
      subscribers: (await getDigestSubscribers()).length,
    }
  : { items: [], subscribers: 0 };
const ownedLists = identity.userId ? await myReadingLists(identity.userId) : [];
// Collaborators for the lists this user owns, so the owner can see and revoke
// them. Collaborated-on lists show no management UI at all — an editor can add
// items, but managing *people* is the owner's call alone.
const collaboratorsByList: Record<string, Awaited<ReturnType<typeof getCollaborators>>> = {};
for (const list of ownedLists.filter((l) => l.isOwner)) {
  collaboratorsByList[list.id] = await getCollaborators(list.id);
}

/* Link suggestions across the writer's own posts. Computed live; each post
   costs one FTS query, which is cheap enough that no caching layer has to be
   invented and then kept honest. */
const linkSuggestions = new Map<string, Awaited<ReturnType<typeof suggestLinks>>>();
if (identity.userId) {
  for (const post of health.slice(0, 10)) {
    const suggestions = await suggestLinks(post.id, identity.userId, 3);
    if (suggestions.length > 0) linkSuggestions.set(post.id, suggestions);
  }
}
const sharedListId = Astro.url.searchParams.get('shared');
let sharedLink: string | null = null;
if (identity.userId && sharedListId) {
  const token = await getListShareToken(sharedListId, identity.userId);
  if (token) {
    const target = ownedLists.find((l) => l.id === sharedListId);
    if (target) sharedLink = `/lists/${target.slug}?key=${token}`;
  }
}

/* Voice: the stored fingerprint, and how the newest post sits against it.
   Refreshed on demand rather than silently — a fingerprint that updates
   itself every publish would chase the latest post instead of judging it. */
let voice: VoiceProfile | null = null;
let voiceDrift: { score: number; moved: string[] } | null = null;
let voiceLatestSlug: string | null = null;
if (identity.userId) {
  const { users } = await import('../lib/db/schema');
  const { readyDb } = await import('../lib/db');
  const { eq } = await import('drizzle-orm');
  const database = await readyDb();
  const [row] = await database
    .select({ toneVector: users.toneVector })
    .from(users)
    .where(eq(users.id, identity.userId))
    .limit(1);
  voice = readVoice(row?.toneVector ?? null);
  const newest = health[0];
  if (voice && newest) {
    const full = await getPostById(newest.id);
    if (full) {
      voiceDrift = driftScore(voice, featuresOfBlocks(full.blocks));
      voiceLatestSlug = newest.slug;
    }
  }
}

/* Synthesis groups, computed live over the inbox every visit. */
const synthGroups =
  identity.userId && captures.length >= 2
    ? synthesizeInbox(captures.map((c) => ({ id: c.id, body: c.body })))
    : [];

const SOURCES = ['scratchpad', 'clip', 'share', 'voice', 'screenshot'] as const;
---

<Base
  title="Studio"
  description="Capture fragments, graduate them to posts, and see which writing needs attention."
  prefs={prefs}
>
  <header class="shell border-b border-rule py-12">
    <div class="max-w-2xl">
      <p class="meta">Writer studio</p>
      <h1 class="mt-3 text-3xl">Studio</h1>
      {!identity.userId && (
        <p class="mt-4 text-[1.0625rem] leading-relaxed text-ink-2">
          Studio belongs to a named writer — it holds your fragments, your
          drafts and your readers' unanswered questions, and none of that has
          anywhere to live until you{' '}
          <a href="/write#handle" class="text-ink no-underline hover:text-accent">
            claim a handle →
          </a>
        </p>
      )}
      {identity.userId && (
        <p class="mt-4 text-[1.0625rem] leading-relaxed text-ink-2">
          Writing as <strong class="font-medium">@{identity.handle}</strong>. Capture first,
          publish when it earns it.
        </p>
      )}
    </div>
  </header>

  {identity.userId && (
    <div class="shell py-12">
      <div class="max-w-2xl space-y-14">
        {studioError && (
          <div class="border border-danger px-4 py-3" role="alert">
            <p class="text-[0.9375rem] text-danger">{studioError}</p>
            <p class="meta mt-1">Nothing was changed.</p>
          </div>
        )}

        <section aria-labelledby="loom-heading">
          <h2 id="loom-heading" class="text-xl">First loom</h2>
          <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-2">
            The loop the whole product is about, as a checklist. Each item is
            computed from what actually happened — nothing here can be checked
            off by visiting a page, because a tour completed is not a thing
            learned.
          </p>
          <ol class="mt-4 space-y-3">
            {(() => {
              const published = health.length > 0;
              const revised = health.some((p) => p.versionCount > 1);
              const noted = health.some((p) => p.notes > 0);
              const first = health[0];
              const steps = [
                {
                  done: published,
                  title: 'Publish something',
                  detail: published
                    ? `${plural(health.length, 'post')} live.`
                    : 'Grow a fragment above, import an archive, or fork a post you wish existed.',
                  href: published ? undefined : '#capture-heading',
                },
                {
                  done: revised,
                  title: 'Revise it',
                  detail: revised
                    ? 'At least one post has a post-publish revision. That is the maintenance flywheel turning.'
                    : first
                      ? 'Open your newest post in the editor, change a sentence, and publish with a summary.'
                      : 'Needs a published post first.',
                  href: !revised && first ? `/studio/edit/${first.slug}` : undefined,
                },
                {
                  done: noted,
                  title: 'Earn a margin note',
                  detail: noted
                    ? 'A reader argued with a specific sentence. Reply from the margin.'
                    : 'Cannot be forced — but posts with a live diff and an honest dek get read, and read posts get argued with.',
                  href: undefined,
                },
              ];
              const doneCount = steps.filter((s) => s.done).length;
              return (
                <>
                  <p class="meta mb-1" role="status">
                    {doneCount} of {steps.length} woven
                    {doneCount === steps.length ? ' — loom complete.' : ''}
                  </p>
                  {steps.map((s) => (
                    <li class="flex items-start gap-3 border border-rule p-3">
                      <span aria-hidden="true" class="mt-0.5 font-mono text-[0.875rem]">
                        {s.done ? '✓' : '○'}
                      </span>
                      <div class="min-w-0">
                        <p class="text-[0.9375rem] font-medium">{s.title}</p>
                        <p class="mt-0.5 text-[0.875rem] leading-relaxed text-ink-2">{s.detail}</p>
                        {s.href && !s.done && (
                          <p class="meta mt-1.5">
                            <a href={s.href} class="no-underline hover:text-ink">
                              Start →
                            </a>
                          </p>
                        )}
                      </div>
                    </li>
                  ))}
                </>
              );
            })()}
          </ol>
        </section>

        <section aria-labelledby="capture-heading">
          <h2 id="capture-heading" class="text-xl">Capture</h2>
          <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-2">
            The bottleneck is noticing, not publishing. Get the fragment down
            in seconds; decide what it becomes later.
          </p>
          <p class="mt-3 text-[0.9375rem]">
            <a
              href="/studio/synthesis"
              class="underline decoration-rule underline-offset-4 hover:decoration-accent"
            >
              Synthesise the canon →
            </a>{' '}
            <span class="text-ink-3">Four views of everything published: topic digest, a reading path for newcomers, the questions readers could not find answers to, and your revision log.</span>
          </p>
          <p class="mt-2 text-[0.9375rem]">
            <a
              href="/capture"
              class="underline decoration-rule underline-offset-4 hover:decoration-accent"
            >
              Capture from your phone →
            </a>{' '}
            <span class="text-ink-3">
              Dictate, or share text and screenshots into it — the operating system
              reads the image for you.
            </span>
          </p>
          <form method="post" action="/api/studio" class="mt-4 border border-rule p-4">
            <input type="hidden" name="action" value="capture" />
            <label class="meta" for="capture-body">
              New fragment
            </label>
            <textarea
              id="capture-body"
              name="body"
              rows={3}
              maxlength={4000}
              required
              placeholder="The sentence you do not want to lose…"
              class="mt-1.5 w-full resize-y border border-rule bg-paper px-3 py-2 text-[0.9375rem] leading-relaxed focus:border-accent focus:outline-none"
            />
            <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
              <label class="meta flex items-center gap-2">
                Source
                <select
                  name="source"
                  class="border border-rule bg-paper px-2 py-1 text-[0.75rem] focus:border-accent focus:outline-none"
                >
                  {SOURCES.map((s) => (
                    <option value={s}>{s}</option>
                  ))}
                </select>
              </label>
              <button
                type="submit"
                class="border border-ink bg-ink px-3 py-1.5 text-[0.875rem] text-paper transition-colors hover:border-accent hover:bg-accent"
              >
                Capture it
              </button>
            </div>
          </form>

          {captures.length === 0 && seeds.length === 0 ? (
            <p class="mt-4 border-l-2 border-rule-strong pl-3 text-[0.9375rem] text-ink-2">
              Inbox empty. The first fragment is the hardest; after that this
              list is the reason the next post starts itself.
            </p>
          ) : (
            <ol class="mt-4 space-y-3">
              {[...seeds, ...captures].map((c) => (
                <li class="border border-rule p-3">
                  <p class="text-[0.9375rem] leading-relaxed">{c.body}</p>
                  <div class="meta mt-2 flex flex-wrap items-center gap-x-3 gap-y-1">
                    <span>{c.source}</span>
                    <span aria-hidden="true">·</span>
                    <span>{ago(c.capturedAt)}</span>
                    {c.state === 'seed' && <span aria-hidden="true">·</span>}
                    {c.state === 'seed' && <span class="text-pine">seed</span>}
                    <span class="ml-auto flex items-center gap-2">
                      {c.state === 'inbox' && (
                        <form method="post" action="/api/studio" class="contents">
                          <input type="hidden" name="action" value="state" />
                          <input type="hidden" name="id" value={c.id} />
                          <input type="hidden" name="to" value="seed" />
                          <button type="submit" class="hover:text-ink">
                            keep
                          </button>
                        </form>
                      )}
                      <form method="post" action="/api/studio" class="contents">
                        <input type="hidden" name="action" value="promote" />
                        <input type="hidden" name="id" value={c.id} />
                        <button type="submit" class="hover:text-ink">
                          {c.promotedPostId ? 'open draft →' : 'grow into a seedling →'}
                        </button>
                      </form>
                      <form method="post" action="/api/studio" class="contents">
                        <input type="hidden" name="action" value="state" />
                        <input type="hidden" name="id" value={c.id} />
                        <input type="hidden" name="to" value="discarded" />
                        <button type="submit" class="hover:text-danger">
                          discard
                        </button>
                      </form>
                    </span>
                  </div>
                </li>
              ))}
            </ol>
          )}
        </section>

        {synthGroups.length > 0 && (
          <section aria-labelledby="synthesis-heading">
            <h2 id="synthesis-heading" class="text-xl">Taking shape</h2>
            <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-2">
              Fragments using the same unusual words are usually two halves of
              one post trying to happen. Grow a group when it earns it; leave
              the rest — forcing unrelated fragments together is how synthesis
              becomes slop.
            </p>
            <ol class="mt-4 space-y-4">
              {synthGroups.map((g, gi) => (
                <li class="border border-rule p-4">
                  <p class="meta">
                    {g.ids.length} fragments · on {g.shared.join(', ')}
                  </p>
                  <ul class="mt-2 space-y-1.5">
                    {g.bodies.map((b, bi) => (
                      <li class="border-l-2 border-rule-strong pl-2 text-[0.875rem] leading-relaxed text-ink-2">
                        {b.length > 220 ? `${b.slice(0, 220)}…` : b}
                        {bi < g.bodies.length - 1 && <span class="sr-only">;</span>}
                      </li>
                    ))}
                  </ul>
                  <form method="post" action="/api/studio" class="mt-3">
                    <input type="hidden" name="action" value="grow" />
                    <input type="hidden" name="ids" value={g.ids.join(',')} />
                    <button
                      type="submit"
                      class="border border-ink bg-ink px-3 py-1.5 text-[0.875rem] text-paper transition-colors hover:border-accent hover:bg-accent"
                    >
                      Grow group {gi + 1} into a seedling →
                    </button>
                  </form>
                </li>
              ))}
            </ol>
          </section>
        )}

        <section aria-labelledby="attention-heading">
          <h2 id="attention-heading" class="text-xl">Needs attention</h2>
          <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-2">
            Ordered by neglect: unanswered reader questions first, then stalest
            review. Maintenance is the product, so this list is the homepage.
          </p>
          {health.length === 0 ? (
            <p class="mt-4 border-l-2 border-rule-strong pl-3 text-[0.9375rem] text-ink-2">
              No posts yet. Grow something from the inbox above.
            </p>
          ) : (
            <ol class="mt-4 space-y-4">
              {health.map((post) => (
                <li class="border border-rule p-4">
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                    <StatusBadge status={post.status} />
                    {post.openAsks > 0 && (
                      <span class="meta text-ochre">
                        {plural(post.openAsks, 'unanswered question')}
                      </span>
                    )}
                  </div>
                  <h3 class="mt-2 text-lg">
                    <a href={`/w/${post.slug}`} class="no-underline hover:text-accent">
                      {post.title}
                    </a>
                  </h3>
                  <p class="meta mt-1.5">
                    {post.versionCount} {post.versionCount === 1 ? 'version' : 'versions'} ·{' '}
                    {plural(post.notes, 'note')} ·{' '}
                    {post.staleDays === null
                      ? 'never reviewed'
                      : post.staleDays === 0
                        ? 'reviewed today'
                        : `reviewed ${post.staleDays}d ago`}
                  </p>
                  {post.staleDays !== null && (
                    <p class="mt-1.5">
                      <a
                        href={`/studio/readers/${post.slug}`}
                        class="meta no-underline text-ink-3 hover:text-ink"
                      >
                        where readers get to →
                      </a>
                    </p>
                  )}
                  {lintByPost.get(post.id)!.findings.length > 0 && (
                    <details class="note-disclosure mt-2">
                      <summary class="meta cursor-pointer text-ink-3 hover:text-ink">
                        {lintByPost.get(post.id)!.findings.length} claim
                        {lintByPost.get(post.id)!.findings.length === 1 ? '' : 's'} without a
                        source
                      </summary>
                      <ul class="mt-2 space-y-2">
                        {lintByPost.get(post.id)!.findings.map((f) => (
                          <li class="border-l-2 border-ochre pl-2">
                            <p class="text-[0.875rem] leading-relaxed text-ink-2">{f.quote}</p>
                            <p class="meta mt-1">{f.detail}</p>
                          </li>
                        ))}
                      </ul>
                      <p class="meta mt-2">
                        {lintByPost.get(post.id)!.claimsChecked} claims checked ·
                        {lintByPost.get(post.id)!.citationsFound} with sources. Advisory, not a
                        fact-check.
                      </p>
                    </details>
                  )}
                  {(openAsksByPost.get(post.id) ?? []).length > 0 && (
                    <ul class="mt-3 space-y-2 border-t border-rule pt-3">
                      {(openAsksByPost.get(post.id) ?? []).map((q) => (
                        <li class="text-[0.875rem] leading-relaxed text-ink-2">
                          <span class="text-ochre">“{q.question}”</span>{' '}
                          <span class="meta">· asked {ago(q.createdAt)}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                  <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-rule pt-3">
                    <form method="post" action="/api/studio" class="contents">
                      <input type="hidden" name="action" value="reviewed" />
                      <input type="hidden" name="postId" value={post.id} />
                      <button type="submit" class="meta text-ink-3 hover:text-ink">
                        Mark reviewed — still true
                      </button>
                    </form>
                    {post.status !== 'evergreen' && (
                      <form method="post" action="/api/studio" class="contents">
                        <input type="hidden" name="action" value="reviewed" />
                        <input type="hidden" name="postId" value={post.id} />
                        <input
                          type="hidden"
                          name="status"
                          value={post.status === 'seedling' ? 'budding' : 'evergreen'}
                        />
                        <button type="submit" class="meta text-pine hover:text-ink">
                          Graduate to {post.status === 'seedling' ? 'budding' : 'evergreen'}
                        </button>
                      </form>
                    )}
                    <details class="note-disclosure">
                      <summary class="meta cursor-pointer text-ink-3 hover:text-ink">Link</summary>
                      <form method="post" action="/api/studio" class="mt-2 flex flex-wrap items-center gap-2">
                        <input type="hidden" name="action" value="link" />
                        <input type="hidden" name="fromPostId" value={post.id} />
                        <label class="sr-only" for={`link-to-${post.id}`}>
                          Link to post slug
                        </label>
                        <input
                          id={`link-to-${post.id}`}
                          name="toSlug"
                          required
                          maxlength={120}
                          placeholder="other-post-slug"
                          class="min-w-0 flex-1 border border-rule bg-paper px-2 py-1 text-[0.8125rem] focus:border-accent focus:outline-none"
                        />
                        <select
                          name="type"
                          aria-label="Link type"
                          class="border border-rule bg-paper px-2 py-1 text-[0.8125rem] focus:border-accent focus:outline-none"
                        >
                          <option value="cites">cites</option>
                          <option value="extends">extends</option>
                          <option value="contradicts">contradicts</option>
                          <option value="mentions">mentions</option>
                        </select>
                        <button
                          type="submit"
                          class="border border-ink bg-ink px-2 py-1 text-[0.8125rem] text-paper transition-colors hover:border-accent hover:bg-accent"
                        >
                          Add
                        </button>
                      </form>
                    </details>
                  </div>
                </li>
              ))}
            </ol>
          )}
        </section>

        <section aria-labelledby="voice-heading">
          <h2 id="voice-heading" class="text-xl">Voice</h2>
          {!voice ? (
            <>
              <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-2">
                No fingerprint yet. It learns from published posts — sentence
                length, vocabulary range, how often you ask, how often you show
                code — so there has to be something published first.
              </p>
              <form method="post" action="/api/studio" class="mt-3">
                <input type="hidden" name="action" value="voice" />
                <button
                  type="submit"
                  class="border border-ink bg-ink px-3 py-1.5 text-[0.875rem] text-paper transition-colors hover:border-accent hover:bg-accent"
                >
                  Learn my voice
                </button>
              </form>
            </>
          ) : (
            <>
              <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-2">
                Learned from {plural(voice.postCount, 'published post')}. Not
                stylometry and not a model — sentence length, vocabulary range,
                asking, code density. Numbers that cannot explain themselves
                would be worse than none.
              </p>
              <dl class="mt-3 grid grid-cols-2 gap-x-8 gap-y-2 border border-rule p-4 sm:grid-cols-3">
                <div>
                  <dt class="meta">Sentences / post</dt>
                  <dd class="mt-1 font-mono text-[0.9375rem] tabular-nums">
                    {Math.round(voice.features.sentences)}
                  </dd>
                </div>
                <div>
                  <dt class="meta">Words / sentence</dt>
                  <dd class="mt-1 font-mono text-[0.9375rem] tabular-nums">
                    {voice.features.meanSentenceWords.toFixed(1)}
                  </dd>
                </div>
                <div>
                  <dt class="meta">Vocabulary range</dt>
                  <dd class="mt-1 font-mono text-[0.9375rem] tabular-nums">
                    {(voice.features.typeTokenRatio * 100).toFixed(0)}%
                  </dd>
                </div>
              </dl>
              {voiceDrift && voiceLatestSlug && (
                <p class="mt-3 border-l-2 border-rule-strong pl-3 text-[0.9375rem] leading-relaxed text-ink-2">
                  Latest post reads{' '}
                  {voiceDrift.score < 0.15 ? (
                    <>like you.</>
                  ) : voiceDrift.score < 0.35 ? (
                    <>
                      a little off your fingerprint
                      {voiceDrift.moved.length > 0 && <> — {voiceDrift.moved.join(', ')} moved</>}:
                    </>
                  ) : (
                    <>
                      nothing like your other {plural(voice.postCount, 'post')}
                      {voiceDrift.moved.length > 0 && <> — {voiceDrift.moved.join(', ')} moved</>}:
                    </>
                  )}{' '}
                  <a href={`/w/${voiceLatestSlug}`} class="text-ink no-underline hover:text-accent">
                    read it →
                  </a>
                </p>
              )}
              <form method="post" action="/api/studio" class="mt-3">
                <input type="hidden" name="action" value="voice" />
                <button type="submit" class="meta text-ink-3 hover:text-ink">
                  Re-learn from current posts
                </button>
              </form>
            </>
          )}
        </section>

        <section aria-labelledby="digest-heading">
          <h2 id="digest-heading" class="text-xl">Weekly digest</h2>
          <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-2">
            What Monday's send would contain — same function the sender calls,
            so the preview cannot drift from what goes out. Empty weeks send
            nothing.
          </p>
          {digestPreview.items.length === 0 ? (
            <p class="mt-3 border-l-2 border-rule-strong pl-3 text-[0.9375rem] text-ink-2">
              Quiet week: nothing new or revised in the last seven days.
              {digestPreview.subscribers === 0
                ? ' Nobody subscribed yet, either.'
                : ` ${digestPreview.subscribers} ${digestPreview.subscribers === 1 ? 'subscriber' : 'subscribers'} waiting.`}
            </p>
          ) : (
            <>
              <ol class="mt-4 space-y-3">
                {digestPreview.items.map((item, i) => (
                  <li class="border border-rule p-3">
                    <p class="meta">
                      {i + 1} · {item.kind === 'new' ? 'new' : 'revised'}
                    </p>
                    <p class="mt-1 font-medium">
                      <a href={`/w/${item.slug}`} class="no-underline hover:text-accent">
                        {item.title}
                      </a>
                    </p>
                    <p class="mt-1 text-[0.875rem] text-ink-2">{item.detail}</p>
                  </li>
                ))}
              </ol>
              <p class="meta mt-3">
                {digestPreview.subscribers} {digestPreview.subscribers === 1 ? 'subscriber' : 'subscribers'} ·
                sends Monday 09:00 UTC when DEPLOY_URL and CRON_SECRET are set
              </p>
            </>
          )}
        </section>

        <section aria-labelledby="lists-heading">
          <h2 id="lists-heading" class="text-xl">Reading lists</h2>
          <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-2">
            Curate in the open, or keep a list private and share it by link.
            Private lists answer 404 to everyone else — even confirming one
            exists would leak that it does.
          </p>
          <form method="post" action="/api/lists" class="mt-4 border border-rule p-4">
            <input type="hidden" name="action" value="create" />
            <div class="grid gap-3 sm:grid-cols-2">
              <label class="block">
                <span class="meta">Name</span>
                <input
                  name="title"
                  required
                  minlength={3}
                  maxlength={120}
                  placeholder="Before the argument"
                  class="mt-1 w-full border border-rule bg-paper px-3 py-2 text-[0.9375rem] focus:border-accent focus:outline-none"
                />
              </label>
              <label class="block">
                <span class="meta">Visibility</span>
                <select
                  name="isPublic"
                  class="mt-1 w-full border border-rule bg-paper px-3 py-2 text-[0.9375rem] focus:border-accent focus:outline-none"
                >
                  <option value="public">Public — listed with the others</option>
                  <option value="private">Private — only you, until shared</option>
                </select>
              </label>
            </div>
            <label class="meta mt-3 block" for="list-desc">
              Description
            </label>
            <input
              id="list-desc"
              name="description"
              maxlength={500}
              placeholder="Why these, in this order"
              class="mt-1 w-full border border-rule bg-paper px-3 py-2 text-[0.9375rem] focus:border-accent focus:outline-none"
            />
            <button
              type="submit"
              class="mt-3 border border-ink bg-ink px-3 py-1.5 text-[0.875rem] text-paper transition-colors hover:border-accent hover:bg-accent"
            >
              New list
            </button>
          </form>

          {sharedLink && (
            <p class="meta mt-3 border border-pine px-3 py-2 text-pine" role="status">
              Share link: <code class="border border-rule bg-sunken px-1">{sharedLink}</code> —
              anyone holding it can read the list. Rotating replaces it.
            </p>
          )}

          {ownedLists.length > 0 && (
            <ol class="mt-4 space-y-3">
              {ownedLists.map((list) => (
                <li class="border border-rule p-4">
                  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                    <a href={`/lists/${list.slug}`} class="font-medium no-underline hover:text-accent">
                      {list.title}
                    </a>
                    <span class="meta">
                      {list.items} {list.items === 1 ? 'post' : 'posts'} ·{' '}
                      {list.isPublic ? 'public' : 'private'}
                      {!list.isPublic && list.hasShareLink ? ' · shared by link' : ''}
                      {!list.isOwner ? ' · with you' : ''}
                    </span>
                    {list.isOwner && (
                      <span class="ml-auto flex items-center gap-2">
                        <form method="post" action="/api/lists" class="contents">
                          <input type="hidden" name="action" value="visibility" />
                          <input type="hidden" name="listId" value={list.id} />
                          <input type="hidden" name="isPublic" value={list.isPublic ? 'private' : 'public'} />
                          <button type="submit" class="meta text-ink-3 hover:text-ink">
                            Make {list.isPublic ? 'private' : 'public'}
                          </button>
                        </form>
                        {!list.isPublic &&
                          (list.hasShareLink ? (
                            <form method="post" action="/api/lists" class="contents">
                              <input type="hidden" name="action" value="revoke" />
                              <input type="hidden" name="listId" value={list.id} />
                              <button type="submit" class="meta text-ink-3 hover:text-danger">
                                Revoke link
                              </button>
                            </form>
                          ) : (
                            <form method="post" action="/api/lists" class="contents">
                              <input type="hidden" name="action" value="share" />
                              <input type="hidden" name="listId" value={list.id} />
                              <button type="submit" class="meta text-ink-3 hover:text-ink">
                                Get share link
                              </button>
                            </form>
                          ))}
                      </span>
                    )}
                  </div>

                  {/* Collaborators — a named, revocable alternative to a share
                      link, and only the owner manages them. */}
                  {list.isOwner && (
                    <div class="mt-3 border-t border-rule pt-3">
                      {(collaboratorsByList[list.id] ?? []).filter((c) => !c.isOwner).length > 0 && (
                        <ul class="mb-2 space-y-1">
                          {(collaboratorsByList[list.id] ?? []).filter((c) => !c.isOwner).map((c) => (
                            <li class="flex items-center gap-2 text-[0.875rem]">
                              <span>@{c.handle}</span>
                              <span class="meta">{c.role}</span>
                              <form method="post" action="/api/lists" class="ml-auto contents">
                                <input type="hidden" name="action" value="remove-collaborator" />
                                <input type="hidden" name="listId" value={list.id} />
                                <input type="hidden" name="handle" value={c.handle} />
                                <button type="submit" class="meta text-ink-3 hover:text-danger">
                                  Remove
                                </button>
                              </form>
                            </li>
                          ))}
                        </ul>
                      )}
                      <form method="post" action="/api/lists" class="flex flex-wrap items-end gap-2">
                        <input type="hidden" name="action" value="add-collaborator" />
                        <input type="hidden" name="listId" value={list.id} />
                        <div class="min-w-0 flex-1">
                          <label class="meta block" for={`collab-handle-${list.id}`}>Add a collaborator</label>
                          <input
                            id={`collab-handle-${list.id}`}
                            name="handle"
                            required
                            placeholder="handle"
                            class="mt-1 w-full border border-rule bg-paper px-2 py-1 text-[0.875rem] focus:border-accent focus:outline-none"
                          />
                        </div>
                        <div>
                          <label class="meta block" for={`collab-role-${list.id}`}>Role</label>
                          <select
                            id={`collab-role-${list.id}`}
                            name="role"
                            class="mt-1 border border-rule bg-paper px-2 py-1 text-[0.875rem]"
                          >
                            <option value="viewer">Viewer (read)</option>
                            <option value="editor">Editor (add/remove)</option>
                          </select>
                        </div>
                        <button type="submit" class="border border-ink bg-ink px-2 py-1 text-[0.875rem] text-paper transition-colors hover:border-accent hover:bg-accent">
                          Add
                        </button>
                      </form>
                    </div>
                  )}
                </li>
              ))}
            </ol>
          )}
        </section>

        {linkSuggestions.size > 0 && (
          <section aria-labelledby="links-heading">
            <h2 id="links-heading" class="text-xl">Connect the archive</h2>
            <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-2">
              Posts sharing vocabulary that are not linked yet. Shared words
              can mean a real relationship or a coincidence — you decide the
              type, or leave them be.
            </p>
            <ol class="mt-4 space-y-4">
              {health
                .filter((post) => linkSuggestions.has(post.id))
                .map((post) => (
                  <li class="border border-rule p-4">
                    <p class="meta">
                      From{' '}
                      <a href={`/w/${post.slug}`} class="no-underline hover:text-ink">
                        {post.title}
                      </a>
                    </p>
                    <ul class="mt-2 space-y-3">
                      {(linkSuggestions.get(post.id) ?? []).map((s) => (
                        <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1 border-t border-rule pt-3 first:border-t-0 first:pt-0">
                          <div class="min-w-0 flex-1">
                            <a href={`/w/${s.slug}`} class="no-underline hover:text-accent">
                              {s.title}
                            </a>
                            <p class="meta mt-1">shares: {s.shared.join(', ')}</p>
                          </div>
                          <form method="post" action="/api/studio" class="flex items-center gap-2">
                            <input type="hidden" name="action" value="link" />
                            <input type="hidden" name="fromPostId" value={post.id} />
                            <input type="hidden" name="toSlug" value={s.slug} />
                            <select
                              name="type"
                              aria-label={`Link type from ${post.title} to ${s.title}`}
                              class="border border-rule bg-paper px-2 py-1 text-[0.8125rem] focus:border-accent focus:outline-none"
                            >
                              <option value="mentions">mentions</option>
                              <option value="cites">cites</option>
                              <option value="extends">extends</option>
                              <option value="contradicts">contradicts</option>
                            </select>
                            <button
                              type="submit"
                              class="border border-ink bg-ink px-2 py-1 text-[0.8125rem] text-paper transition-colors hover:border-accent hover:bg-accent"
                            >
                              Link
                            </button>
                          </form>
                        </li>
                      ))}
                    </ul>
                  </li>
                ))}
            </ol>
          </section>
        )}

        {flagged.length > 0 && (
          <section aria-labelledby="flagged-heading">
            <h2 id="flagged-heading" class="text-xl">
              Flagged <span class="meta">· by your readers, for you to judge</span>
            </h2>
            <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-2">
              A report hides nothing by itself. Read the reason; hide what does
              not belong, dismiss the rest by leaving it visible.
            </p>
            <ol class="mt-4 space-y-3">
              {flagged.map((note) => (
                <li class="border border-rule p-4">
                  <p class="meta">
                    {note.kind} · {plural(note.reports, 'report')} · on{' '}
                    <a href={`/w/${note.postSlug}`} class="no-underline hover:text-ink">
                      {note.postTitle}
                    </a>
                    {note.status === 'hidden' && <span aria-hidden="true"> · </span>}
                    {note.status === 'hidden' && <span class="text-ochre">hidden</span>}
                  </p>
                  <p class="mt-1.5 text-[0.875rem] leading-relaxed text-ink-2">{note.body}</p>
                  <p class="mt-1.5 border-l-2 border-rule-strong pl-2 text-[0.8125rem] italic text-ink-3">
                    “{note.latestReason}”
                  </p>
                  <form method="post" action="/api/notes" class="mt-2">
                    <input
                      type="hidden"
                      name="action"
                      value="visibility"
                    />
                    <input type="hidden" name="noteId" value={note.id} />
                    <input
                      type="hidden"
                      name="status"
                      value={note.status === 'hidden' ? 'visible' : 'hidden'}
                    />
                    <input type="hidden" name="returnTo" value="/studio" />
                    <button
                      type="submit"
                      class:list={[
                        'meta hover:text-ink',
                        note.status === 'hidden' ? 'text-pine' : 'text-ink-3 hover:text-danger',
                      ]}
                    >
                      {note.status === 'hidden' ? 'Restore' : 'Hide'}
                    </button>
                  </form>
                </li>
              ))}
            </ol>
          </section>
        )}
      </div>
    </div>
  )}
</Base>
