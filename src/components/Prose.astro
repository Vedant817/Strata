---
/**
 * Renders a typed block document to HTML.
 *
 * Every block carries `data-block-id` (stable across revisions — this is what
 * annotations and telemetry attach to) and `data-layer`, which the depth dial
 * uses to collapse content. The whole document renders server-side; the depth
 * dial is a progressive enhancement over a complete, readable page.
 */
import type { Block } from '../lib/blocks';
import { blockInlineSource } from '../lib/blocks';
import { renderInline, slugify } from '../lib/inline';
import { findQuoteRange, renderRanges, type InlineRange } from '../lib/inline-diff';
import { highlightCode, type Highlighted } from '../lib/highlight';
import { runnableFor } from '../lib/sandbox';
import type { AnnotationView } from '../lib/repo/annotations';
import NoteCard from './NoteCard.astro';
import Artifact from './Artifact.astro';
import CodeRunner from './CodeRunner.astro';

interface Props {
  blocks: Block[];
  /** Diff segments keyed by block id, when rendering a revision comparison. */
  diffSegments?: Record<string, Array<{ type: 'same' | 'ins' | 'del'; text: string; html?: string }>>;
  changeStatus?: Record<string, 'added' | 'removed' | 'modified' | 'unchanged'>;
  /** Notes to render in the margin, keyed by block id. */
  notes?: Record<string, AnnotationView[]>;
  /** Replies to render beneath their parent note. */
  replies?: Record<string, AnnotationView[]>;
  postSlug?: string;
  postId?: string;
  canAccept?: boolean;
  returnTo?: string;
  mine?: string[];
  /** This reader's own highlight quotes, keyed by block id, painted back onto
   *  the text server-side so a highlight survives a reload. */
  myHighlights?: Record<string, string[]>;
  versionNumber?: number;
}

const {
  blocks,
  diffSegments,
  changeStatus,
  notes = {},
  replies = {},
  postSlug = '',
  postId = '',
  canAccept = false,
  returnTo = '',
  mine = [],
  myHighlights = {},
} = Astro.props;

/* Highlight every code block up front, in parallel, so the render loop below
   stays synchronous. One Shiki instance is created and reused per process. */
const codeHighlight = new Map<string, Highlighted>();
await Promise.all(
  blocks
    .filter((b) => b.type === 'code')
    .map(async (b) => {
      const codeBlock = b as Extract<Block, { type: 'code' }>;
      codeHighlight.set(codeBlock.id, await highlightCode(codeBlock.code, codeBlock.lang));
    }),
);

/** Diff segments arrive pre-rendered from the inline-aware tokeniser, so a code
 *  span inside an edited paragraph stays a code span. */
const segHtml = (segments: Array<{ type: string; html?: string; text: string }>): string =>
  segments
    .map((s) => {
      const html = s.html ?? renderInline(s.text);
      if (s.type === 'ins') return `<span class="diff-ins">${html}</span>`;
      if (s.type === 'del') return `<span class="diff-del">${html}</span>`;
      return html;
    })
    .join('');
---

<div class="prose-post">
  {
    blocks.map((block) => {
      const id = block.id;
      const status = changeStatus?.[id];
      const segments = diffSegments?.[id];
      const changed = status && status !== 'unchanged';
      const body = () =>
        segments ? segHtml(segments) : renderInline(blockInlineSource(block));

      /* A block with notes gets a real margin rail: the notes render server-side
         into the same grid cell as the block and CSS moves them beside it at
         wide widths. No JS is involved in reading them. */
      const blockNotes = notes[id] ?? [];
      const hasNotes = blockNotes.length > 0;
      const renderBody = () => {
        if (segments) return segHtml(segments);
        const first = blockNotes[0];
        const source = blockInlineSource(block);
        const inlinable =
          block.type === 'paragraph' ||
          block.type === 'tldr' ||
          block.type === 'heading' ||
          block.type === 'quote' ||
          block.type === 'primer';

        if (!inlinable) return renderInline(source);

        /* A note anchor and a reader's own highlight can land on the same words,
           so both are painted in one pass to keep the tags properly nested. The
           highlight is listed first and carries the lower priority number, so a
           reader never loses their own mark to somebody else's note. */
        const ranges: InlineRange[] = [];
        for (const quote of myHighlights[id] ?? []) {
          const found = findQuoteRange(source, quote);
          if (found) {
            ranges.push({
              ...found,
              className: 'reader-highlight',
              attrs: ' data-reader-highlight=""',
              tag: 'mark',
              priority: 0,
            });
          }
        }
        if (first && first.resolved.status !== 'lost' && first.anchor.quote) {
          ranges.push({
            start: first.resolved.start,
            end: first.resolved.end,
            className: first.isMine ? 'hl-anchor hl-mine' : 'hl-anchor',
            attrs: ` data-note-anchor="${first.id}"`,
            priority: 1,
          });
        }
        return ranges.length > 0 ? renderRanges(source, ranges) : renderInline(source);
      };

        return (
          <div
            id={`block-${id}`}
            data-block-id={id}
            data-layer={block.layer}
            data-block-type={block.type}
            data-change={status}
            class:list={[
            'block-with-notes',
            changed && 'diff-block',
            status === 'removed' && 'opacity-70',
          ]}
        >
          <div class="min-w-0">
            {block.type === 'tldr' && (
              <aside class="border-l-2 border-accent pl-5">
                <p class="meta mb-2">In one paragraph</p>
                <p class="!text-[1.125rem] leading-relaxed" set:html={renderBody()} />
              </aside>
            )}

            {block.type === 'heading' && block.level === 2 && (
              <h2 id={slugify(block.text)} class="scroll-mt-24">
                <a href={`#${slugify(block.text)}`} class="no-underline hover:text-accent" set:html={body()} />
              </h2>
            )}

            {block.type === 'heading' && block.level === 3 && (
              <h3 id={slugify(block.text)} class="scroll-mt-24">
                <a href={`#${slugify(block.text)}`} class="no-underline hover:text-accent" set:html={body()} />
              </h3>
            )}

            {block.type === 'paragraph' && <p set:html={renderBody()} />}

            {block.type === 'quote' && (
              <figure>
                <blockquote class="!m-0">
                  <p set:html={body()} />
                  {block.attribution && (
                    <figcaption class="meta mt-2 not-italic">— {block.attribution}</figcaption>
                  )}
                </blockquote>
              </figure>
            )}

            {block.type === 'callout' && (
              <aside
                class:list={[
                  'border p-4 text-[0.9375rem]',
                  block.tone === 'correction' && 'border-accent bg-accent-soft',
                  block.tone === 'warn' && 'border-ochre',
                  block.tone === 'note' && 'border-rule bg-sunken',
                ]}
              >
                {block.title && (
                  <p
                    class:list={[
                      'meta mb-1',
                      block.tone === 'correction' && 'text-accent',
                      block.tone === 'warn' && 'text-ochre',
                    ]}
                  >
                    {block.title}
                  </p>
                )}
                <p class="!m-0 leading-relaxed" set:html={body()} />
              </aside>
            )}

            {block.type === 'primer' && (
              <aside class="border border-dashed border-rule-strong bg-sunken p-4">
                <p class="meta mb-1">
                  <span class="text-ink">{block.term}</span> — context
                </p>
                <p class="!m-0 text-[0.9375rem] leading-relaxed text-ink-2" set:html={body()} />
              </aside>
            )}

            {block.type === 'code' && (() => {
              /* Highlighted once here, then both themes ship in the HTML and
                 CSS picks one by data-theme. Highlighting per request per
                 theme would double the work; highlighting in the browser would
                 ship a highlighter to the reader. */
              const h = codeHighlight.get(block.id) ?? ({} as Highlighted);
              /* Two independent opt-ins, so a snippet is never runnable just
                 because it is a code block. See docs/threat-model-sandbox.md. */
              const run = runnableFor(block);
              return (
                <>
                  <figure class="code-figure">
                    <figcaption class="code-bar">
                      <span class="meta" data-code-lang>
                        {h.lang ?? block.lang}
                      </span>
                      {run && (
                        <span class="meta" data-code-runnable={run.dialect}>
                          runnable
                        </span>
                      )}
                      <button
                        type="button"
                        class="meta code-copy"
                        data-code-copy
                        aria-label="Copy this snippet"
                      >
                        Copy
                      </button>
                    </figcaption>
                    <pre class="code-body" data-code={block.code} data-highlighted={h.paper ? '1' : '0'}>
                      {h.paper ? (
                        <>
                          <code class="theme-paper" set:html={h.paper} />
                          {h.ink && <code class="theme-ink" set:html={h.ink} />}
                        </>
                      ) : (
                        <code>{block.code}</code>
                      )}
                    </pre>
                    {block.caption && <figcaption class="meta mt-2">{block.caption}</figcaption>}
                  </figure>
                  {run && (
                    <CodeRunner
                      code={block.code}
                      dialect={run.dialect}
                      lang={block.lang}
                      caption={block.caption}
                    />
                  )}
                </>
              );
            })()}

            {block.type === 'list' &&
              (block.ordered ? (
                <ol class="list-decimal pl-6 space-y-2">
                  {block.items.map((item) => (
                    <li set:html={renderInline(item)} />
                  ))}
                </ol>
              ) : (
                <ul class="list-none pl-0 space-y-2">
                  {block.items.map((item) => (
                    /* `min-w-0` on both spans is load-bearing. A flex item defaults
                       to `min-width: auto`, which means it refuses to shrink below
                       its own content — so one long unbroken token in a list item
                       (a URL from an imported archive) pushed the entire page to
                       4410px on a 375px screen, and the reader lost the left edge
                       of every line. */
                    <li class="flex gap-3">
                      <span aria-hidden="true" class="min-w-0 text-ink-3 select-none">
                        —
                      </span>
                      <span class="min-w-0" set:html={renderInline(item)} />
                    </li>
                  ))}
                </ul>
              ))}

            {block.type === 'table' && (
              <div class="overflow-x-auto">
                <table class="w-full border-collapse text-[0.9375rem]">
                  <thead>
                    <tr>
                      {block.head.map((h) => (
                        <th class="border-b border-rule-strong px-3 py-2 text-left font-medium" set:html={renderInline(h)} />
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {block.rows.map((row) => (
                      <tr>
                        {row.map((cell) => (
                          <td class="border-b border-rule px-3 py-2 align-top text-ink-2" set:html={renderInline(cell)} />
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}

            {block.type === 'figure' && (
              <figure>
                <img
                  src={block.src}
                  alt={block.alt}
                  width="1600"
                  height="900"
                  class="h-auto w-full"
                  loading="lazy"
                  decoding="async"
                />
                {block.caption && <figcaption class="meta mt-2">{block.caption}</figcaption>}
              </figure>
            )}

            {block.type === 'interactive' && (
              <Artifact component={block.component} title={block.title} props={block.props} />
            )}
          </div>

          {hasNotes && (
            <div class="block-notes" data-notes-for={id}>
              <p class="meta mb-2 xl:sr-only">
                {blockNotes.length === 1 ? '1 note' : `${blockNotes.length} notes`}
              </p>
              {
                blockNotes.map((note) => (
                  <NoteCard
                    id={note.id}
                    kind={note.kind}
                    body={note.body}
                    authorName={note.authorName}
                    authorHandle={note.authorHandle}
                    createdAt={note.createdAt}
                    editedAt={note.editedAt}
                    isAuthor={note.isAuthor}
                    isMine={note.isMine}
                    isAccepted={note.isAccepted}
                    onOlderRevision={note.onOlderRevision}
                    anchorLost={note.resolved.status === 'lost'}
                    quote={note.anchor.quote}
                    versionNumber={note.versionNumber}
                    postSlug={postSlug}
                    postId={postId}
                    canAccept={canAccept}
                    returnTo={returnTo}
                    mine={mine}
                    replies={replies[note.id] ?? []}
                    reactions={note.reactions}
                  />
                ))
              }
            </div>
          )}
        </div>
      );
    })
  }
</div>

<script is:inline>
  (() => {
    /* Copy a snippet. The raw text is carried in data-code, because the visible
       markup is full of span elements and copying the DOM would copy the
       highlighting with it. */
    for (const btn of document.querySelectorAll('[data-code-copy]')) {
      btn.addEventListener('click', async () => {
        const pre = btn.closest('.code-figure')?.querySelector('[data-code]');
        const text = pre?.getAttribute('data-code') ?? '';
        if (!text) return;
        try {
          await navigator.clipboard.writeText(text);
          btn.textContent = 'Copied';
          btn.setAttribute('data-state', 'copied');
        } catch {
          // Clipboard denied (insecure context, or the reader said no): say so
          // rather than pretending it worked.
          btn.textContent = 'Ctrl+C';
        }
        setTimeout(() => {
          btn.textContent = 'Copy';
          btn.removeAttribute('data-state');
        }, 1600);
      });
    }
  })();
</script>
