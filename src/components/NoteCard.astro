---
import { relativeTime } from '../lib/format';
import type { AnnotationKind } from '../lib/db/schema';
import type { AnnotationView } from '../lib/repo/annotations';
// Self-referential: a reply renders as a note, one level down and without its own
// reply affordance. Aliased because the import would otherwise collide with this
// component's own name.
import NoteReply from './NoteCard.astro';

interface Props {
  id: string;
  kind: AnnotationKind;
  body: string;
  authorName: string;
  authorHandle: string | null;
  createdAt: number;
  editedAt?: number | null;
  isAuthor: boolean;
  /** This reader wrote it — the only condition under which edit and delete show. */
  isMine?: boolean;
  isAccepted: boolean;
  onOlderRevision: boolean;
  anchorLost: boolean;
  quote: string;
  versionNumber: number;
  postSlug: string;
  postId?: string;
  /** The post's author may fold a correction into the revision history. */
  canAccept?: boolean;
  /** Where to send the reader back to. Same page, query string intact. */
  returnTo?: string;
  /** Reaction kinds this reader has already given, as `noteId:kind`. */
  mine?: string[];
  replies?: AnnotationView[];
  /** 0 for a note on the margin, 1 for a reply. Replies do not thread further:
   *  a conversation three deep is unreadable in a 19rem rail. */
  depth?: number;
  reactions?: { useful: number; insightful: number; source: number };
}

const {
  id,
  kind,
  body,
  authorName,
  authorHandle,
  createdAt,
  editedAt,
  isAuthor,
  isMine = false,
  isAccepted,
  onOlderRevision,
  anchorLost,
  quote,
  versionNumber,
  postSlug,
  postId = '',
  canAccept = false,
  returnTo = '',
  mine = [],
  replies = [],
  depth = 0,
  reactions = { useful: 0, insightful: 0, source: 0 },
} = Astro.props;

const LABELS: Record<AnnotationKind, string> = {
  comment: 'Comment',
  correction: 'Correction',
  extension: 'Extension',
  disagreement: 'Disagreement',
  worked_example: 'Worked example',
  update: 'Update',
  author_note: 'Author’s note',
};

const REACTIONS = [
  { kind: 'useful', label: 'useful' },
  { kind: 'insightful', label: 'insightful' },
  { kind: 'source', label: 'sourced' },
] as const;

/* Only these kinds argue *with* the post, so only these are worth accepting
   into the revision history as an attributed amendment. */
const ACCEPTABLE: AnnotationKind[] = ['correction', 'disagreement', 'update', 'extension'];

const mineSet = new Set(mine);
const back = returnTo || Astro.url.pathname + Astro.url.search;
/* Replies do not thread further and do not carry reactions: a conversation
   three deep is unreadable in a 19rem rail. But a reply is still its author's
   words, so edit and delete stay available on it. */
const canReact = depth === 0;
const canReply = depth === 0;
const canEdit = isMine;
const showAccept = canAccept && !isMine && !isAccepted && ACCEPTABLE.includes(kind);
const totalReactions = reactions.useful + reactions.insightful + reactions.source;
---

<article
  id={`note-${id}`}
  class:list={[
    'border-b border-rule py-3 last:border-b-0 first:pt-0',
    isAuthor && 'note-author pl-3',
    depth > 0 && 'note-reply border-l-2 border-rule pl-3',
  ]}
  data-note-id={id}
  data-note-kind={kind}
>
  <p class="meta flex flex-wrap items-center gap-x-2">
    <span class:list={['note-kind-' + kind]}>
      {LABELS[kind]}
      {isAccepted && <span class="text-pine"> · accepted</span>}
    </span>
  </p>

  {
    quote && depth === 0 && (
      <blockquote class="mt-1.5 border-l-2 border-rule-strong pl-2 text-[0.8125rem] leading-snug text-ink-3 italic">
        {quote}
      </blockquote>
    )
  }

  <p class="mt-1.5 text-[0.875rem] leading-relaxed text-ink-2">{body}</p>

  <p class="meta mt-1.5 flex flex-wrap items-center gap-x-2">
    {
      authorHandle ? (
        <a href={`/a/${authorHandle}`} class="no-underline hover:text-ink">
          {authorName}
        </a>
      ) : (
        <span>{authorName}</span>
      )
    }
    <span aria-hidden="true">·</span>
    <span>{relativeTime(createdAt)}</span>
    {
      editedAt && (
        <>
          <span aria-hidden="true">·</span>
          <span title={new Date(editedAt).toISOString()}>edited</span>
        </>
      )
    }
    {/* The share unit: a link to this note alone, not to the post. Arguing with
        one sentence is a better object to send than a URL. */}
    <span aria-hidden="true">·</span>
    <a href={`/w/${postSlug}#note-${id}`} class="no-underline hover:text-ink">
      link
    </a>
  </p>

  {
    onOlderRevision && (
      <p class="mt-1.5 text-[0.75rem] leading-snug text-ochre">
        <a href={`/w/${postSlug}?rev=${versionNumber}#note-${id}`} class="no-underline hover:underline">
          This note is on revision {versionNumber} — read that version to see what it argued with →
        </a>
      </p>
    )
  }

  {
    anchorLost && (
      <p class="mt-1.5 text-[0.75rem] leading-snug text-ink-3">
        The sentence this note was attached to has since been rewritten out of the post.
      </p>
    )
  }

  {
    canReact && (
      <div class="mt-2 flex flex-wrap items-center gap-1.5">
        {REACTIONS.map((r) => {
          const given = mineSet.has(`${id}:${r.kind}`);
          const count = reactions[r.kind];
          return (
            <form method="post" action="/api/notes" class="contents">
              <input type="hidden" name="action" value="react" />
              <input type="hidden" name="noteId" value={id} />
              <input type="hidden" name="kind" value={r.kind} />
              <input type="hidden" name="returnTo" value={back} />
              <button
                type="submit"
                aria-pressed={given}
                class:list={[
                  'border px-2 py-1 text-[0.75rem] transition-colors',
                  given
                    ? 'border-accent text-accent'
                    : 'border-rule text-ink-3 hover:border-rule-strong hover:text-ink',
                ]}
              >
                {r.label}
                {count > 0 && <span class="tabular-nums"> {count}</span>}
              </button>
            </form>
          );
        })}
        {totalReactions === 0 && (
          <span class="meta ml-1">Was this worth reading?</span>
        )}
      </div>
    )
  }

  {
    (canReply || canEdit) && (
      <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1">
        {canReply && (
          <details class="note-disclosure">
            <summary class="meta cursor-pointer text-ink-3 hover:text-ink">Reply</summary>
            <form method="post" action="/api/notes" class="mt-2">
              <input type="hidden" name="action" value="reply" />
              <input type="hidden" name="parentId" value={id} />
              <input type="hidden" name="returnTo" value={back} />
              <label class="sr-only" for={`reply-${id}`}>
                Reply to this note
              </label>
              <textarea
                id={`reply-${id}`}
                name="body"
                rows={3}
                maxlength={4000}
                required
                placeholder="Argue with this, or add what it left out."
                class="w-full resize-y border border-rule bg-paper px-3 py-2 text-[0.875rem] leading-relaxed focus:border-accent focus:outline-none"
              />
              <button
                type="submit"
                class="mt-1.5 border border-ink bg-ink px-3 py-1 text-[0.8125rem] text-paper transition-colors hover:border-accent hover:bg-accent"
              >
                Post reply
              </button>
            </form>
          </details>
        )}

        {canEdit && (
          <details class="note-disclosure">
            <summary class="meta cursor-pointer text-ink-3 hover:text-ink">Edit</summary>
            <form method="post" action="/api/notes" class="mt-2">
              <input type="hidden" name="action" value="edit" />
              <input type="hidden" name="noteId" value={id} />
              <input type="hidden" name="returnTo" value={back} />
              <label class="sr-only" for={`edit-${id}`}>
                Edit your note
              </label>
              <textarea
                id={`edit-${id}`}
                name="body"
                rows={3}
                maxlength={4000}
                required
                class="w-full resize-y border border-rule bg-paper px-3 py-2 text-[0.875rem] leading-relaxed focus:border-accent focus:outline-none"
              >
                {body}
              </textarea>
              <button
                type="submit"
                class="mt-1.5 border border-ink bg-ink px-3 py-1 text-[0.8125rem] text-paper transition-colors hover:border-accent hover:bg-accent"
              >
                Save
              </button>
            </form>
          </details>
        )}

        {canEdit && (
          <form method="post" action="/api/notes" class="contents">
            <input type="hidden" name="action" value="remove" />
            <input type="hidden" name="noteId" value={id} />
            <input type="hidden" name="returnTo" value={back} />
            <button
              type="submit"
              class="meta text-ink-3 hover:text-danger"
              onclick="return confirm('Delete this note? Replies to it stay, but the note itself goes.')"
            >
              Delete
            </button>
          </form>
        )}

        {!isMine && (
          <details class="note-disclosure">
            <summary class="meta cursor-pointer text-ink-3 hover:text-ink">Report</summary>
            <form method="post" action="/api/notes" class="mt-2 flex flex-wrap items-center gap-2">
              <input type="hidden" name="action" value="report" />
              <input type="hidden" name="noteId" value={id} />
              <input type="hidden" name="returnTo" value={back} />
              <label class="sr-only" for={`report-${id}`}>
                Why does this note not belong here?
              </label>
              <input
                id={`report-${id}`}
                name="reason"
                required
                minlength={3}
                maxlength={500}
                placeholder="Spam, abuse, off-topic…"
                class="min-w-0 flex-1 border border-rule bg-paper px-2 py-1 text-[0.8125rem] focus:border-accent focus:outline-none"
              />
              <button
                type="submit"
                class="border border-rule px-2 py-1 text-[0.8125rem] text-ink-3 transition-colors hover:border-danger hover:text-danger"
              >
                Flag for the author
              </button>
            </form>
          </details>
        )}
      </div>
    )
  }

  {
    showAccept && (
      <form method="post" action="/api/notes" class="mt-2">
        <input type="hidden" name="action" value="accept" />
        <input type="hidden" name="noteId" value={id} />
        <input type="hidden" name="postId" value={postId} />
        <input type="hidden" name="returnTo" value={back} />
        <button
          type="submit"
          class="border border-pine px-2 py-1 text-[0.75rem] text-pine transition-colors hover:bg-pine hover:text-paper"
        >
          Accept this into the revision history
        </button>
        <p class="mt-1 text-[0.75rem] leading-snug text-ink-3">
          It becomes an attributed amendment, and {authorName} is credited on it.
        </p>
      </form>
    )
  }

  {
    replies.length > 0 && (
      <div class="mt-2 space-y-1">
        {replies.map((child) => (
          <NoteReply
            id={child.id}
            kind={child.kind}
            body={child.body}
            authorName={child.authorName}
            authorHandle={child.authorHandle}
            createdAt={child.createdAt}
            editedAt={child.editedAt}
            isAuthor={child.isAuthor}
            isMine={child.isMine}
            isAccepted={child.isAccepted}
            onOlderRevision={child.onOlderRevision}
            anchorLost={child.resolved.status === 'lost'}
            quote={child.anchor.quote}
            versionNumber={child.versionNumber}
            postSlug={postSlug}
            postId={postId}
            canAccept={canAccept}
            returnTo={returnTo}
            mine={mine}
            depth={depth + 1}
          />
        ))}
      </div>
    )
  }
</article>
